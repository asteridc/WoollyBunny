  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041E\u0442: \u041C\u0438\u0440\u0435\u043B\u044C \u0414\u0435\u2019\u041B\u0430\u043C\u043E\r\n\u041A\u043E\u043C\u0443:
    \u0418\u043B\u0430\u0439 \u0425\u0430\u0440\u0440\u0435\u0434\r\n\r\n\xAB\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439,
    \u0434\u043E\u0440\u043E\u0433\u043E\u0439 \u043F\u043B\u0435\u043C\u044F\u043D\u043D\u0438\u043A.\r\n\r\n\u042F
    \u043D\u0435 \u0445\u043E\u0447\u0443 \u0442\u044F\u043D\u0443\u0442\u044C \u0441
    \u044D\u0442\u0438\u043C, \u043D\u0435 \u043C\u043E\u0433\u0443 \u0434\u0435\u0440\u0436\u0430\u0442\u044C
    \u0442\u0430\u043A\u043E\u0435 \u0432 \u0441\u0435\u0431\u0435\u2026 \u0422\u0432\u043E\u0438
    \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0438 \u043C\u0435\u0440\u0442\u0432\u044B.
    \u041E\u043D\u0438 \u043F\u043E\u0433\u0438\u0431\u043B\u0438 \u0432 \u0430\u0432\u0438\u0430\u043A\u0430\u0442\u0430\u0441\u0442\u0440\u043E\u0444\u0435.
    \u042F \u0431\u044B\u043B\u0430 \u0443\u0434\u0438\u0432\u043B\u0435\u043D\u0430,
    \u0447\u0442\u043E \u0442\u044B \u0431\u044B\u043B \u043D\u0435 \u0441 \u043D\u0438\u043C\u0438.
    \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u044F \u043F\u043E\u0434\u0443\u043C\u0430\u043B\u0430...\r\n\r"
