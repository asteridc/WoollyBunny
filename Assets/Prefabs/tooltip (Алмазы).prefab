      objectReference: {fileID: 0}
    - target: {fileID: 3235201764145827039, guid: 19931da71a2a5d44a869b0040f013f0d, type: 3}
      propertyPath: m_text
      value: "\u0414\u0440\u0430\u0433\u043E\u0446\u0435\u043D\u043D\u043E\u0441\u0442\u0438"
      objectReference: {fileID: 0}
    - target: {fileID: 3892373169966012866, guid: 19931da71a2a5d44a869b0040f013f0d, type: 3}
      propertyPath: englishText
      value: Gems
      objectReference: {fileID: 0}
    - target: {fileID: 3892373169966012866, guid: 19931da71a2a5d44a869b0040f013f0d, type: 3}
      propertyPath: russianText
      value: "\u0414\u0440\u0430\u0433\u043E\u0446\u0435\u043D\u043D\u043E\u0441\u0442\u0438"
      objectReference: {fileID: 0}
    - target: {fileID: 4481249929881861953, guid: 19931da71a2a5d44a869b0040f013f0d, type: 3}
      propertyPath: m_text
      value: "\u0420\u0435\u0434\u043A\u0430\u044F \u0432\u0430\u043B\u044E\u0442\u0430,
        \u0437\u0430 \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043C\u043E\u0436\u043D\u043E
        \u043A\u0443\u043F\u0438\u0442\u044C \u0434\u043E\u0440\u043E\u0433\u043E\u0441\u0442\u043E\u044F\u0449\u0438\u0435
        \u0442\u043E\u0432\u0430\u0440\u044B."
      objectReference: {fileID: 0}
    - target: {fileID: 4481249929881861953, guid: 19931da71a2a5d44a869b0040f013f0d, type: 3}
      propertyPath: m_margin.w
      value: -63.54425
      objectReference: {fileID: 0}
    - target: {fileID: 4844296176804156404, guid: 19931da71a2a5d44a869b0040f013f0d, type: 3}
      propertyPath: englishText
      value: "Eli\u2019s current energy. It's necessary for activities. Increase
        his maximum energy by raising your Story Level."
      objectReference: {fileID: 0}
    - target: {fileID: 4844296176804156404, guid: 19931da71a2a5d44a869b0040f013f0d, type: 3}
      propertyPath: russianText
      value: "\u0422\u0435\u043A\u0443\u0449\u0438\u0439 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C
        \u044D\u043D\u0435\u0440\u0433\u0438\u0438 \u0418\u043B\u0430\u044F. \u041D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C
        \u0434\u043B\u044F \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0435\u0439.
        \u041F\u043E\u0432\u044B\u0448\u0430\u0442\u044C \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0439
        \u0437\u0430\u043F\u0430\u0441 \u044D\u043D\u0435\u0440\u0433\u0438\u0438
        \u043C\u043E\u0436\u043D\u043E \u043F\u0443\u0442\u0435\u043C \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u044F
        \u0423\u0440\u043E\u0432\u043D\u044F \u0421\u044E\u0436\u0435\u0442\u0430."
      objectReference: {fileID: 0}
