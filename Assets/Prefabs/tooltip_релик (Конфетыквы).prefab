--- !u!114 &7440508862008053100
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4335827949545217346}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ab4e3cca31ec2f845b660c0e40ccea61, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LocalizedText
  russianText: "\u0421\u043B\u0430\u0434\u043E\u0441\u0442\u0438, \u0431\u0435\u0437
    \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043D\u0435 \u043E\u0431\u0445\u043E\u0434\u0438\u0442\u0441\u044F
    \u043D\u0438 \u043E\u0434\u0438\u043D \u0425\u0435\u043B\u043B\u043E\u0443\u0438\u043D!\n\n\u0421\u043E\u0431\u0438\u0440\u0430\u0439\u0442\u0435
    \u041A\u043E\u043D\u0444\u0435\u0442\u044B\u043A\u0432\u044B, \u043E\u0431\u0445\u043E\u0434\u044F
    \u0434\u043E\u043C\u0430 \u041B\u0438\u0440\u044C\u0435\u043D\u0430 \u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u044F
    \u0433\u0430\u0434\u043A\u0438\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u044F,
    \u0438 \u043E\u0431\u043C\u0435\u043D\u0438\u0432\u0430\u0439\u0442\u0435 \u0438\u0445
    \u043D\u0430 \u043E\u0441\u043E\u0431\u044B\u0439 \u043F\u0440\u0438\u0437. \u0422\u043E\u043B\u044C\u043A\u043E
    \u043D\u0435 \u0441\u044A\u0435\u0448\u044C\u0442\u0435 \u0438\u0445 \u0440\u0430\u043D\u044C\u0448\u0435
    \u0432\u0440\u0435\u043C\u0435\u043D\u0438!"
  englishText: "Sweets that are an essential part of every Halloween!\r\n\r\nCollect
    Scandy by visiting houses in Lirien and completing mischievous tasks, then trade
    them in for a special prize. Just make sure you don\u2019t eat them all beforehand!"
