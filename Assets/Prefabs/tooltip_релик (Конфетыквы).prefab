    - target: {fileID: 6088962223778704926, guid: dc84b53fcf6897e4e9325e5f5dc41cd9, type: 3}
      propertyPath: englishText
      value: The pistol has a 5% chance to instantly kill a regular enemy. Against
        elites, it instead deals 220% of its base damage. The effect does not apply
        to bosses.
      objectReference: {fileID: 0}
    - target: {fileID: 6088962223778704926, guid: dc84b53fcf6897e4e9325e5f5dc41cd9, type: 3}
      propertyPath: russianText
      value: "\u041F\u0438\u0441\u0442\u043E\u043B\u0435\u0442 \u0441 \u0448\u0430\u043D\u0441\u043E\u043C
        5% \u0441\u0432\u043E\u0438\u043C \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u043E\u043C
        \u0434\u043E\u0431\u044C\u0435\u0442 \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E
        \u0432\u0440\u0430\u0433\u0430, \u0430 \u044D\u043B\u0438\u0442\u043D\u043E\u043C\u0443
        \u043D\u0430\u043D\u0435\u0441\u0435\u0442 \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u044B\u0439
        \u0443\u0440\u043E\u043D \u0432 \u0440\u0430\u0437\u043C\u0435\u0440\u0435
        220% \u043E\u0442 \u0438\u0437\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0433\u043E
        \u0443\u0440\u043E\u043D\u0430. \u041D\u0430 \u0431\u043E\u0441\u0441\u043E\u0432
        \u044D\u0444\u0444\u0435\u043A\u0442 \u043D\u0435 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u044F\u0435\u0442\u0441\u044F."
      objectReference: {fileID: 0}
