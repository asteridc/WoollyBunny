    \u041D\u0438\u0447\u0442\u043E \u0432 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u043C
    \u0421\u043E\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0438 \u043D\u0435 \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
    \u0432\u0430\u043C \u043F\u0440\u0430\u0432\u0430 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
    \u0438\u0445 \u0434\u043B\u044F \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F
    \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D\u0438\u044F \u043E\u0431
    \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u043C \u043E\u0434\u043E\u0431\u0440\u0435\u043D\u0438\u0438,
    \u043F\u0430\u0440\u0442\u043D\u0435\u0440\u0441\u0442\u0432\u0435 \u0438\u043B\u0438
    \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u043D\u043E\u0441\u0442\u0438
    \u043A \u041F\u0440\u0430\u0432\u043E\u043E\u0431\u043B\u0430\u0434\u0430\u0442\u0435\u043B\u044E
    \u0431\u0435\u0437 \u0435\u0433\u043E \u043F\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
    \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F.\n\n7. \u041F\u041E\u041B\u042C\u0417\u041E\u0412\u0410\u0422\u0415\u041B\u042C\u0421\u041A\u0418\u0419
    \u041A\u041E\u041D\u0422\u0415\u041D\u0422\n\n\u0415\u0441\u043B\u0438 \u043A\u0430\u043A\u0430\u044F-\u043B\u0438\u0431\u043E
    \u0432\u0435\u0440\u0441\u0438\u044F \u0421\u0435\u0440\u0432\u0438\u0441\u043E\u0432
    \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
    \u0432\u0430\u043C \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C
    \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0442\u044C, \u0437\u0430\u0433\u0440\u0443\u0436\u0430\u0442\u044C,
    \u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u0442\u044C \u0438\u043B\u0438
    \u043F\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u0442\u044C \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0439
    \u043A\u043E\u043D\u0442\u0435\u043D\u0442, \u0432\u043A\u043B\u044E\u0447\u0430\u044F
    \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F, \u0442\u0435\u043A\u0441\u0442\u044B,
    \u043E\u0442\u0437\u044B\u0432\u044B, \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044F,
    \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u044F \u0438\u043B\u0438 \u0438\u043D\u044B\u0435
    \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B (\u0434\u0430\u043B\u0435\u0435
    \u2014 \xAB\u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0439
    \u043A\u043E\u043D\u0442\u0435\u043D\u0442\xBB), \u0432\u044B \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442\u0435
    \u043F\u0440\u0430\u0432\u0430 \u043D\u0430 \u0442\u0430\u043A\u043E\u0439 \u043A\u043E\u043D\u0442\u0435\u043D\u0442
    \u0432 \u0442\u043E\u0439 \u0441\u0442\u0435\u043F\u0435\u043D\u0438, \u0432
    \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043E\u043D\u0438 \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u0442
    \u0432\u0430\u043C \u043F\u043E \u0437\u0430\u043A\u043E\u043D\u0443.\n\n\u041F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044F
    \u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0439
    \u043A\u043E\u043D\u0442\u0435\u043D\u0442 \u0447\u0435\u0440\u0435\u0437 \u0421\u0435\u0440\u0432\u0438\u0441\u044B,
    \u0432\u044B \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442\u0435
    \u041F\u0440\u0430\u0432\u043E\u043E\u0431\u043B\u0430\u0434\u0430\u0442\u0435\u043B\u044E
    \u043D\u0435\u0438\u0441\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E,
    \u0432\u0441\u0435\u043C\u0438\u0440\u043D\u0443\u044E, \u0431\u0435\u0437\u0432\u043E\u0437\u043C\u0435\u0437\u0434\u043D\u0443\u044E
    \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u044E \u043D\u0430 \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435,
    \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \u0432\u043E\u0441\u043F\u0440\u043E\u0438\u0437\u0432\u0435\u0434\u0435\u043D\u0438\u0435,
    \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
    \u0442\u0430\u043A\u043E\u0433\u043E \u043A\u043E\u043D\u0442\u0435\u043D\u0442\u0430
    \u0438\u0441\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u0432 \u0442\u043E\u0439 \u0441\u0442\u0435\u043F\u0435\u043D\u0438, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u0430 \u0434\u043B\u044F
    \u0440\u0430\u0431\u043E\u0442\u044B, \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u044F,
    \u0437\u0430\u0449\u0438\u0442\u044B \u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F
    \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0445
    \u0421\u0435\u0440\u0432\u0438\u0441\u043E\u0432.\n\n\u0412\u044B \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u0440\u0443\u0435\u0442\u0435,
    \u0447\u0442\u043E \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442\u0435 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u044B\u043C\u0438
    \u043F\u0440\u0430\u0432\u0430\u043C\u0438 \u043D\u0430 \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u043C\u044B\u0439
    \u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0439
    \u043A\u043E\u043D\u0442\u0435\u043D\u0442 \u0438 \u0447\u0442\u043E \u0435\u0433\u043E
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
    \u0432 \u0440\u0430\u043C\u043A\u0430\u0445 \u0421\u0435\u0440\u0432\u0438\u0441\u043E\u0432
    \u043D\u0435 \u043D\u0430\u0440\u0443\u0448\u0430\u0435\u0442 \u043F\u0440\u0430\u0432\u0430
    \u0442\u0440\u0435\u0442\u044C\u0438\u0445 \u043B\u0438\u0446 \u0438\u043B\u0438
    \u0437\u0430\u043A\u043E\u043D\u043E\u0434\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E.\n\n\u0415\u0441\u043B\u0438
    Woolly Bunny \u043D\u0435 \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
    \u0444\u0443\u043D\u043A\u0446\u0438\u0439 \u0437\u0430\u0433\u0440\u0443\u0437\u043A\u0438
    \u0438\u043B\u0438 \u043F\u0443\u0431\u043B\u0438\u043A\u0430\u0446\u0438\u0438
    \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u0433\u043E
    \u043A\u043E\u043D\u0442\u0435\u043D\u0442\u0430, \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439
    \u0440\u0430\u0437\u0434\u0435\u043B \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F
    \u0442\u043E\u043B\u044C\u043A\u043E \u0432 \u0442\u043E\u0439 \u043C\u0435\u0440\u0435,
    \u0432 \u043A\u0430\u043A\u043E\u0439 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0430\u044F
    \u0444\u0443\u043D\u043A\u0446\u0438\u044F \u0431\u0443\u0434\u0435\u0442 \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u0430
    \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043C.\n\n8. \u0417\u0410\u041F\u0420\u0415\u0429\u0415\u041D\u041D\u041E\u0415
    \u0418\u0421\u041F\u041E\u041B\u042C\u0417\u041E\u0412\u0410\u041D\u0418\u0415\n\n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044F
    \u0421\u0435\u0440\u0432\u0438\u0441\u044B, \u0432\u044B \u043E\u0431\u044F\u0437\u0443\u0435\u0442\u0435\u0441\u044C
    \u043D\u0435:\n\n1. \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
    \u0421\u0435\u0440\u0432\u0438\u0441\u044B \u0434\u043B\u044F \u043D\u0435\u0437\u0430\u043A\u043E\u043D\u043D\u043E\u0439
    \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438;\n\n2.
    \u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
    \u043D\u0435\u0441\u0430\u043D\u043A\u0446\u0438\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u0434\u043E\u0441\u0442\u0443\u043F \u043A \u0438\u0433\u0440\u0435, \u0435\u0435
    \u0441\u0435\u0440\u0432\u0435\u0440\u0430\u043C, \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u043C,
    \u0443\u0447\u0435\u0442\u043D\u044B\u043C \u0437\u0430\u043F\u0438\u0441\u044F\u043C
    \u0438\u043B\u0438 \u0438\u043D\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0435;\n\n3.
    \u0432\u043C\u0435\u0448\u0438\u0432\u0430\u0442\u044C\u0441\u044F \u0432 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u0443\u044E
    \u0440\u0430\u0431\u043E\u0442\u0443 \u0438\u0433\u0440\u044B;\n\n4. \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u044F\u0442\u044C
    \u0432\u0440\u0435\u0434\u043E\u043D\u043E\u0441\u043D\u043E\u0435 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u043D\u043E\u0435
    \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u0435, \u0432\u0438\u0440\u0443\u0441\u044B,
    \u0448\u043F\u0438\u043E\u043D\u0441\u043A\u0438\u0435 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u044B
    \u0438\u043B\u0438 \u0438\u043D\u044B\u0435 \u0432\u0440\u0435\u0434\u043E\u043D\u043E\u0441\u043D\u044B\u0435
    \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u044B;\n\n5. \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
    \u0431\u043E\u0442\u043E\u0432, \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435
    \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0438\u043B\u0438 \u0438\u043D\u044B\u0435
    \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B \u0434\u043B\u044F
    \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u044F \u0434\u043E\u0441\u0442\u0443\u043F\u0430
    \u043A \u0444\u0443\u043D\u043A\u0446\u0438\u044F\u043C \u0421\u0435\u0440\u0432\u0438\u0441\u043E\u0432
    \u0431\u0435\u0437 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F;\n\n6.
    \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0442\u044C \u043F\u043E\u043F\u044B\u0442\u043A\u0438
    \u043E\u0431\u0445\u043E\u0434\u0430 \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u0439, \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0445
    \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u043E\u0432 \u0438\u043B\u0438
    \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u043E\u0432 \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F;\n\n7.
    \u0432\u044B\u0434\u0430\u0432\u0430\u0442\u044C \u0441\u0435\u0431\u044F \u0437\u0430
    \u041F\u0440\u0430\u0432\u043E\u043E\u0431\u043B\u0430\u0434\u0430\u0442\u0435\u043B\u044F,
    \u0435\u0433\u043E \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432,
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043B\u0435\u0439
    \u0438\u043B\u0438 \u0438\u043D\u044B\u0445 \u043B\u0438\u0446;\n\n8. \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
    \u0421\u0435\u0440\u0432\u0438\u0441\u044B \u0434\u043B\u044F \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u0438\u044F
    \u0430\u0432\u0442\u043E\u0440\u0441\u043A\u0438\u0445 \u043F\u0440\u0430\u0432,
    \u0442\u043E\u0432\u0430\u0440\u043D\u044B\u0445 \u0437\u043D\u0430\u043A\u043E\u0432,
    \u043F\u0440\u0430\u0432 \u043D\u0430 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435,
    \u043A\u043E\u043D\u0444\u0438\u0434\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \u0438\u043B\u0438 \u0438\u043D\u044B\u0445 \u043F\u0440\u0430\u0432 \u0442\u0440\u0435\u0442\u044C\u0438\u0445
    \u043B\u0438\u0446;\n\n9. \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
    \u0421\u0435\u0440\u0432\u0438\u0441\u044B \u0434\u043B\u044F \u0443\u0433\u0440\u043E\u0437,
    \u043F\u0440\u0435\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F,
    \u043C\u043E\u0448\u0435\u043D\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u0430
    \u0438\u043B\u0438 \u0438\u043D\u044B\u0445 \u043D\u0435\u0437\u0430\u043A\u043E\u043D\u043D\u044B\u0445
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439.\n\n9. \u041E\u0411\u041D\u041E\u0412\u041B\u0415\u041D\u0418\u042F
    \u0418 \u0418\u0417\u041C\u0415\u041D\u0415\u041D\u0418\u042F \u0418\u0413\u0420\u042B\n\n\u041F\u0440\u0430\u0432\u043E\u043E\u0431\u043B\u0430\u0434\u0430\u0442\u0435\u043B\u044C
    \u0432\u043F\u0440\u0430\u0432\u0435 \u0432\u0440\u0435\u043C\u044F \u043E\u0442
    \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0442\u044C
    \u0438\u0441\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F, \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F,
    \u043F\u0430\u0442\u0447\u0438, \u0434\u043E\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F
    \u0438 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u0438\u0433\u0440\u044B.\n\n\u0422\u0430\u043A\u0438\u0435
    \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F \u043C\u043E\u0433\u0443\u0442
    \u0438\u0437\u043C\u0435\u043D\u044F\u0442\u044C, \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0442\u044C
    \u0438\u043B\u0438 \u0443\u0434\u0430\u043B\u044F\u0442\u044C \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0435
    \u0444\u0443\u043D\u043A\u0446\u0438\u0438, \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B,
    \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0438, \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F
    \u043A \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044E
    \u0438 \u0438\u043D\u044B\u0435 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B
    \u0438\u0433\u0440\u044B.\n\n\u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F \u043C\u043E\u0433\u0443\u0442
    \u0431\u044B\u0442\u044C \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u044B
    \u0434\u043B\u044F \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0435\u043D\u0438\u044F
    \u0440\u0430\u0431\u043E\u0442\u044B \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u044B\u0445
    \u0444\u0443\u043D\u043A\u0446\u0438\u0439 \u0438\u0433\u0440\u044B.\n\n\u041C\u044B
    \u043D\u0435 \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u0440\u0443\u0435\u043C,
    \u0447\u0442\u043E \u043A\u0430\u0436\u0434\u0430\u044F \u0444\u0443\u043D\u043A\u0446\u0438\u044F
    Woolly Bunny \u0431\u0443\u0434\u0435\u0442 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430
    \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E \u0438\u043B\u0438 \u0447\u0442\u043E
    \u0438\u0433\u0440\u0430 \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0442
    \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0431\u0435\u0437 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0439.\n\n10.
    \u0418\u0417\u041C\u0415\u041D\u0415\u041D\u0418\u042F \u041D\u0410\u0421\u0422\u041E\u042F\u0429\u0415\u0413\u041E
    \u0421\u041E\u0413\u041B\u0410\u0428\u0415\u041D\u0418\u042F\n\n\u041C\u044B
    \u0432\u043F\u0440\u0430\u0432\u0435 \u0438\u0437\u043C\u0435\u043D\u044F\u0442\u044C
    \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u0421\u043E\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435
    \u043F\u043E \u043C\u0435\u0440\u0435 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F
    Woolly Bunny, \u0437\u0430\u043A\u043E\u043D\u043E\u0434\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430
    \u0438\u043B\u0438 \u0421\u0435\u0440\u0432\u0438\u0441\u043E\u0432.\n\n\u0418\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F
    \u0432\u0441\u0442\u0443\u043F\u0430\u044E\u0442 \u0432 \u0441\u0438\u043B\u0443
    \u0441 \u0434\u0430\u0442\u044B, \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u0439
    \u0432 \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u043E\u0439 \u0432\u0435\u0440\u0441\u0438\u0438,
    \u0435\u0441\u043B\u0438 \u0438\u043D\u043E\u0435 \u043D\u0435 \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u043E\u0442\u0440\u0435\u043D\u043E
    \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u043C\u044B\u043C \u0437\u0430\u043A\u043E\u043D\u043E\u0434\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E\u043C.\n\n\u0415\u0441\u043B\u0438
    \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E
    \u0437\u0430\u0442\u0440\u0430\u0433\u0438\u0432\u0430\u0435\u0442 \u0432\u0430\u0448\u0438
    \u043F\u0440\u0430\u0432\u0430 \u0438\u043B\u0438 \u043E\u0431\u044F\u0437\u0430\u043D\u043D\u043E\u0441\u0442\u0438,
    \u043C\u044B \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u0435\u043C\u0441\u044F
    \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0440\u0430\u0437\u0443\u043C\u043D\u043E\u0435
    \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u0435 \u0434\u043E
    \u0432\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u044F \u0442\u0430\u043A\u043E\u0433\u043E
    \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u0432 \u0441\u0438\u043B\u0443.\n\n\u0415\u0441\u043B\u0438
    \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u043C\u043E\u0435 \u0437\u0430\u043A\u043E\u043D\u043E\u0434\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u044F
    \u0432\u0430\u0448\u0435\u0433\u043E \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u043E\u0433\u043E
    \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u044F \u0441 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C\u0438
    \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F\u043C\u0438, \u043C\u044B
    \u0437\u0430\u043F\u0440\u043E\u0441\u0438\u043C \u0442\u0430\u043A\u043E\u0435
    \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u0435 \u0434\u043E \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0435\u043D\u0438\u044F
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F
    \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0445
    \u0421\u0435\u0440\u0432\u0438\u0441\u043E\u0432.\n\n\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0435\u043D\u0438\u0435
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F
    \u0421\u0435\u0440\u0432\u0438\u0441\u043E\u0432 \u043F\u043E\u0441\u043B\u0435
    \u0432\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u044F \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0439
    \u0432 \u0441\u0438\u043B\u0443 \u043C\u043E\u0436\u0435\u0442 \u043E\u0437\u043D\u0430\u0447\u0430\u0442\u044C
    \u0432\u0430\u0448\u0435 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u0435 \u0441
    \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u043D\u043E\u0439 \u0432\u0435\u0440\u0441\u0438\u0435\u0439
    \u0421\u043E\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u044F \u0432 \u0442\u043E\u0439
    \u043C\u0435\u0440\u0435, \u0432 \u043A\u0430\u043A\u043E\u0439 \u044D\u0442\u043E
    \u0434\u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u043C\u044B\u043C
    \u0437\u0430\u043A\u043E\u043D\u043E\u0434\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E\u043C.\n\n11.
    \u041F\u041E\u041A\u0423\u041F\u041A\u0418 \u0418 \u0412\u0418\u0420\u0422\u0423\u0410\u041B\u042C\u041D\u042B\u0415
    \u041F\u0420\u0415\u0414\u041C\u0415\u0422\u042B\n\n\u0415\u0441\u043B\u0438
    Woolly Bunny \u0438\u043B\u0438 \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0435
    \u0441 \u043D\u0435\u0439 \u0421\u0435\u0440\u0432\u0438\u0441\u044B \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u0442\u0430\u0442\u044C
    \u0432\u043D\u0443\u0442\u0440\u0438\u0438\u0433\u0440\u043E\u0432\u0443\u044E
    \u0432\u0430\u043B\u044E\u0442\u0443, \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B,
    \u043A\u043E\u0441\u043C\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B \u0438\u043B\u0438 \u0438\u043D\u044B\u0435
    \u0446\u0438\u0444\u0440\u043E\u0432\u044B\u0435 \u043E\u0431\u044A\u0435\u043A\u0442\u044B
    (\u0434\u0430\u043B\u0435\u0435 \u2014 \xAB\u0412\u0438\u0440\u0442\u0443\u0430\u043B\u044C\u043D\u044B\u0435
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B\xBB), \u0442\u0430\u043A\u0438\u0435
    \u043E\u0431\u044A\u0435\u043A\u0442\u044B \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442\u0441\u044F
    \u0432\u0430\u043C \u0432 \u0440\u0430\u043C\u043A\u0430\u0445 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u043E\u0433\u043E
    \u043F\u0440\u0430\u0432\u0430 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F
    \u0438 \u043D\u0435 \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u0432\u0430\u0448\u0435\u0439
    \u043B\u0438\u0447\u043D\u043E\u0439 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C\u044E
    \u0432 \u0442\u043E\u043C \u0436\u0435 \u0441\u043C\u044B\u0441\u043B\u0435,
    \u0447\u0442\u043E \u0438 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044C\u043D\u044B\u0435
    \u0442\u043E\u0432\u0430\u0440\u044B.\n\n\u0412\u0438\u0440\u0442\u0443\u0430\u043B\u044C\u043D\u044B\u0435
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B \u043D\u0435 \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
    \u0434\u0435\u043D\u0435\u0436\u043D\u044B\u043C\u0438 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\u043C\u0438,
    \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u044B\u043C\u0438 \u0434\u0435\u043D\u044C\u0433\u0430\u043C\u0438,
    \u0438\u043D\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u044F\u043C\u0438, \u0446\u0435\u043D\u043D\u044B\u043C\u0438
    \u0431\u0443\u043C\u0430\u0433\u0430\u043C\u0438 \u0438\u043B\u0438 \u0438\u043D\u044B\u043C
    \u0444\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u044B\u043C \u0430\u043A\u0442\u0438\u0432\u043E\u043C
    \u0438, \u0435\u0441\u043B\u0438 \u0438\u043D\u043E\u0435 \u043F\u0440\u044F\u043C\u043E
    \u043D\u0435 \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u043E\u0442\u0440\u0435\u043D\u043E
    \u0437\u0430\u043A\u043E\u043D\u043E\u043C \u0438\u043B\u0438 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u043C\u0438
    \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0439
    \u043F\u043E\u043A\u0443\u043F\u043A\u0438, \u043D\u0435 \u0438\u043C\u0435\u044E\u0442
    \u0434\u0435\u043D\u0435\u0436\u043D\u043E\u0439 \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u0438
    \u0437\u0430 \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u043C\u0438 \u0421\u0435\u0440\u0432\u0438\u0441\u043E\u0432.\n\n\u0412\u0438\u0440\u0442\u0443\u0430\u043B\u044C\u043D\u044B\u0435
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B \u043D\u0435\u043B\u044C\u0437\u044F
    \u043F\u0440\u043E\u0434\u0430\u0432\u0430\u0442\u044C, \u043E\u0431\u043C\u0435\u043D\u0438\u0432\u0430\u0442\u044C,
    \u043F\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u0442\u044C \u0438\u043B\u0438
    \u043F\u043E\u0433\u0430\u0448\u0430\u0442\u044C \u0437\u0430 \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0435
    \u0434\u0435\u043D\u044C\u0433\u0438, \u0435\u0441\u043B\u0438 \u0442\u0430\u043A\u0430\u044F
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u043F\u0440\u044F\u043C\u043E
    \u043D\u0435 \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u043E\u0442\u0440\u0435\u043D\u0430
    \u041F\u0440\u0430\u0432\u043E\u043E\u0431\u043B\u0430\u0434\u0430\u0442\u0435\u043B\u0435\u043C.\n\n\u041F\u0440\u0430\u0432\u043E\u043E\u0431\u043B\u0430\u0434\u0430\u0442\u0435\u043B\u044C
    \u0432\u043F\u0440\u0430\u0432\u0435 \u0438\u0437\u043C\u0435\u043D\u044F\u0442\u044C,
    \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0438\u0432\u0430\u0442\u044C \u0438\u043B\u0438
    \u043F\u0440\u0435\u043A\u0440\u0430\u0449\u0430\u0442\u044C \u0434\u043E\u0441\u0442\u0443\u043F
    \u043A \u0412\u0438\u0440\u0442\u0443\u0430\u043B\u044C\u043D\u044B\u043C \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430\u043C
