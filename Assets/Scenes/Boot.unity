    \u043B\u0438\u0446;\r\n\r\n8. \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
    \u043D\u0435\u0441\u0430\u043D\u043A\u0446\u0438\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435
    \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u044B, \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430
    \u0438\u043B\u0438 \u043C\u0435\u0442\u043E\u0434\u044B, \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u044B\u0435
