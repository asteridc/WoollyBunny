    \u0432\u0430\u043C \u0437\u0430\u043F\u0440\u0435\u0449\u0430\u0435\u0442\u0441\u044F:\n\n1.
    \u043A\u043E\u043F\u0438\u0440\u043E\u0432\u0430\u0442\u044C, \u0432\u043E\u0441\u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u044C
    \u0438\u043B\u0438 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u044F\u0442\u044C
    \u0438\u0433\u0440\u0443 \u0438\u043B\u0438 \u0435\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
    \u0447\u0430\u0441\u0442\u0438;\n\n2. \u043F\u0440\u043E\u0434\u0430\u0432\u0430\u0442\u044C,
