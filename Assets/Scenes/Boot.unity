    \u0437\u0430\u0449\u0438\u0442\u044B \u0438\u0433\u0440\u044B;\r\n\r\n7. \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
    \u0438\u0433\u0440\u0443 \u0442\u0430\u043A\u0438\u043C \u0441\u043F\u043E\u0441\u043E\u0431\u043E\u043C,
