--- !u!114 &1512406341
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1512406339}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ab4e3cca31ec2f845b660c0e40ccea61, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LocalizedText
  russianText: "\u041F\u041E\u041B\u042C\u0417\u041E\u0412\u0410\u0422\u0415\u041B\u042C\u0421\u041A\u041E\u0415
    \u0421\u041E\u0413\u041B\u0410\u0428\u0415\u041D\u0418\u0415\n\u041B\u0438\u0446\u0435\u043D\u0437\u0438\u043E\u043D\u043D\u043E\u0435
    \u0441\u043E\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435 \u0441 \u043A\u043E\u043D\u0435\u0447\u043D\u044B\u043C
    \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u043C
    (EULA)\n\n\u0418\u0433\u0440\u0430: Woolly Bunny\n\u041F\u0440\u0430\u0432\u043E\u043E\u0431\u043B\u0430\u0434\u0430\u0442\u0435\u043B\u044C:
    ASTERID\n\u0414\u0430\u0442\u0430 \u0432\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u044F
    \u0432 \u0441\u0438\u043B\u0443: 11 \u0434\u0435\u043A\u0430\u0431\u0440\u044F
    2024 \u0433.\n\n1. \u041E\u0411\u0429\u0418\u0415 \u041F\u041E\u041B\u041E\u0416\u0415\u041D\u0418\u042F\n\n\u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435
    \u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u0435
    \u0441\u043E\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435, \u0432\u043A\u043B\u044E\u0447\u0430\u044F
    \u0443\u0441\u043B\u043E\u0432\u0438\u044F \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E
    \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u043E\u043D\u043D\u043E\u0433\u043E
    \u0441\u043E\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u044F \u0441 \u043A\u043E\u043D\u0435\u0447\u043D\u044B\u043C
    \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u043C
    (\u0434\u0430\u043B\u0435\u0435 \u2014 \xAB\u0421\u043E\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435\xBB),
    \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u0435\u0442 \u0443\u0441\u043B\u043E\u0432\u0438\u044F
    \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u0442\u0435\u043D\u0438\u044F, \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438,
    \u0434\u043E\u0441\u0442\u0443\u043F\u0430 \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F
    \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u043D\u043E\u0439 \u0438\u0433\u0440\u044B
    Woolly Bunny, \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u043D\u043E\u0435
    \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u0435 \u0438\u0433\u0440\u044B,
    \u0435\u0435 \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F, \u0434\u043E\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F,
    \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439 \u0441\u0430\u0439\u0442
    \u0438 \u0438\u043D\u044B\u0435 \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0435
    \u0441 \u0438\u0433\u0440\u043E\u0439 \u0446\u0438\u0444\u0440\u043E\u0432\u044B\u0435
    \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B \u0438 \u0441\u0435\u0440\u0432\u0438\u0441\u044B,
    \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u043C\u044B\u0435
    \u041F\u0440\u0430\u0432\u043E\u043E\u0431\u043B\u0430\u0434\u0430\u0442\u0435\u043B\u0435\u043C
    (\u0434\u0430\u043B\u0435\u0435 \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u043E
    \u2014 \xAB\u0421\u0435\u0440\u0432\u0438\u0441\u044B\xBB).\n\nASTERID (\u0434\u0430\u043B\u0435\u0435
    \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u043E \u0438\u043B\u0438 \u043F\u043E
    \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438 \u2014 \xAB\u041F\u0440\u0430\u0432\u043E\u043E\u0431\u043B\u0430\u0434\u0430\u0442\u0435\u043B\u044C\xBB,
    \xAB\u043C\u044B\xBB, \xAB\u043D\u0430\u0441\xBB, \xAB\u043D\u0430\u0448\xBB)
    \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043F\u0440\u0430\u0432\u043E\u043E\u0431\u043B\u0430\u0434\u0430\u0442\u0435\u043B\u0435\u043C
    \u0438\u043B\u0438 \u043D\u0430\u0434\u043B\u0435\u0436\u0430\u0449\u0438\u043C
    \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0430\u0442\u043E\u043C \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0445
    \u043F\u0440\u0430\u0432 \u043D\u0430 Woolly Bunny, \u0432\u043A\u043B\u044E\u0447\u0430\u044F
    \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u043D\u044B\u0439 \u043A\u043E\u0434,
    \u0433\u0440\u0430\u0444\u0438\u043A\u0443, \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0435\u0439,
    \u043F\u0440\u043E\u0438\u0437\u0432\u0435\u0434\u0435\u043D\u0438\u044F, \u0442\u0435\u043A\u0441\u0442\u044B,
    \u043C\u0443\u0437\u044B\u043A\u0443, \u0430\u0443\u0434\u0438\u043E\u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u044B\u0435
    \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B \u0438 \u0438\u043D\u044B\u0435
    \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B \u0438\u0433\u0440\u044B.\n\n\u0423\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044F,
    \u043A\u043E\u043F\u0438\u0440\u0443\u044F, \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u044F
    \u0438\u043B\u0438 \u0438\u043D\u044B\u043C \u043E\u0431\u0440\u0430\u0437\u043E\u043C
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044F Woolly Bunny, \u0430 \u0442\u0430\u043A\u0436\u0435
    \u043D\u0430\u0436\u0438\u043C\u0430\u044F \u043A\u043D\u043E\u043F\u043A\u0443
    \xAB\u041F\u0440\u0438\u043D\u044F\u0442\u044C\xBB, \xABI Agree\xBB, Enter \u0438\u043B\u0438
    \u0430\u043D\u0430\u043B\u043E\u0433\u0438\u0447\u043D\u0443\u044E \u043A\u043D\u043E\u043F\u043A\u0443,
    \u043A\u043E\u0433\u0434\u0430 \u0442\u0430\u043A\u0430\u044F \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C
    \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F,
    \u0432\u044B \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442\u0435,
    \u0447\u0442\u043E \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043B\u0438 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435
    \u0421\u043E\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435, \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442\u0435
    \u0435\u0433\u043E \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435
    \u0438 \u0441\u043E\u0433\u043B\u0430\u0448\u0430\u0435\u0442\u0435\u0441\u044C
    \u0441\u043E\u0431\u043B\u044E\u0434\u0430\u0442\u044C \u0435\u0433\u043E \u0443\u0441\u043B\u043E\u0432\u0438\u044F.\n\n\u0415\u0441\u043B\u0438
    \u0432\u044B \u043D\u0435 \u0441\u043E\u0433\u043B\u0430\u0441\u043D\u044B \u0441
    \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u043C \u0421\u043E\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435\u043C,
    \u043D\u0435 \u0443\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0439\u0442\u0435
    \u0438 \u043D\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
    \u0438\u0433\u0440\u0443. \u041F\u0440\u0438 \u043D\u0430\u043B\u0438\u0447\u0438\u0438
    \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0439
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438 \u043F\u0440\u0435\u043A\u0440\u0430\u0442\u0438\u0442\u0435
    \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443 \u0438\u043B\u0438 \u0443\u0434\u0430\u043B\u0438\u0442\u0435
    \u0438\u0433\u0440\u0443.\n\n\u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435
