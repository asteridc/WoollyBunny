    \u0423\u0411\u042B\u0422\u041A\u041E\u0412\r\n\r\n\u0412 \u0442\u043E\u0439 \u0441\u0442\u0435\u043F\u0435\u043D\u0438,
    \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u044D\u0442\u043E \u0434\u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F
    \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u043C\u044B\u043C \u0437\u0430\u043A\u043E\u043D\u043E\u0434\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E\u043C,
    \u0432\u044B \u0441\u043E\u0433\u043B\u0430\u0448\u0430\u0435\u0442\u0435\u0441\u044C
    \u0432\u043E\u0437\u043C\u0435\u0441\u0442\u0438\u0442\u044C \u041F\u0440\u0430\u0432\u043E\u043E\u0431\u043B\u0430\u0434\u0430\u0442\u0435\u043B\u044E
    \u0440\u0430\u0437\u0443\u043C\u043D\u044B\u0435 \u0443\u0431\u044B\u0442\u043A\u0438,
    \u0440\u0430\u0441\u0445\u043E\u0434\u044B \u0438 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F
    \u0442\u0440\u0435\u0442\u044C\u0438\u0445 \u043B\u0438\u0446, \u0432\u043E\u0437\u043D\u0438\u043A\u0448\u0438\u0435
    \u043D\u0435\u043F\u043E\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u043E
    \u0432\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0435:\r\n\r\n1. \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
    \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u0438\u044F \u0432\u0430\u043C\u0438
    \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E \u0421\u043E\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u044F;\r\n2.
    \u043D\u0435\u0437\u0430\u043A\u043E\u043D\u043D\u043E\u0433\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F
    \u0432\u0430\u043C\u0438 \u0421\u0435\u0440\u0432\u0438\u0441\u043E\u0432;\r\n3.
    \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u0438\u044F \u0432\u0430\u043C\u0438
    \u043F\u0440\u0430\u0432 \u0442\u0440\u0435\u0442\u044C\u0438\u0445 \u043B\u0438\u0446.\r\n\r\n\u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439
    \u0440\u0430\u0437\u0434\u0435\u043B \u043D\u0435 \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F
    \u0432 \u0442\u043E\u0439 \u0441\u0442\u0435\u043F\u0435\u043D\u0438, \u0432
    \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0442\u0430\u043A\u043E\u0435 \u0432\u043E\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u0435
    \u0437\u0430\u043F\u0440\u0435\u0449\u0435\u043D\u043E \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u043C\u044B\u043C
    \u0437\u0430\u043A\u043E\u043D\u043E\u0434\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E\u043C
    \u0438\u043B\u0438 \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u043A
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F\u043C \u0441\u0430\u043C\u043E\u0433\u043E
    \u041F\u0440\u0430\u0432\u043E\u043E\u0431\u043B\u0430\u0434\u0430\u0442\u0435\u043B\u044F.\r\n\r\n16.
    \u041F\u0420\u0415\u041A\u0420\u0410\u0429\u0415\u041D\u0418\u0415 \u041B\u0418\u0426\u0415\u041D\u0417\u0418\u0418\r\n\r\n\u0412\u0430\u0448\u0430
    \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u044F \u043F\u0440\u0435\u043A\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438,
    \u0435\u0441\u043B\u0438 \u0432\u044B \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E
    \u043D\u0430\u0440\u0443\u0448\u0430\u0435\u0442\u0435 \u0443\u0441\u043B\u043E\u0432\u0438\u044F
    \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E \u0421\u043E\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u044F,
    \u0435\u0441\u043B\u0438 \u0438\u043D\u043E\u0435 \u043D\u0435 \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u043E\u0442\u0440\u0435\u043D\u043E
    \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C \u0437\u0430\u043A\u043E\u043D\u043E\u0434\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E\u043C.\r\n\r\n\u041F\u043E\u0441\u043B\u0435
    \u043F\u0440\u0435\u043A\u0440\u0430\u0449\u0435\u043D\u0438\u044F \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0438
    \u0432\u044B \u043E\u0431\u044F\u0437\u0430\u043D\u044B \u043F\u0440\u0435\u043A\u0440\u0430\u0442\u0438\u0442\u044C
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
    \u0438\u0433\u0440\u044B \u0438 \u0443\u0434\u0430\u043B\u0438\u0442\u044C \u0432\u0441\u0435
    \u043D\u0430\u0445\u043E\u0434\u044F\u0449\u0438\u0435\u0441\u044F \u043F\u043E\u0434
    \u0432\u0430\u0448\u0438\u043C \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u043C
    \u043A\u043E\u043F\u0438\u0438 \u0438\u0433\u0440\u044B, \u0435\u0441\u043B\u0438
    \u0442\u0430\u043A\u043E\u0435 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u0435
    \u0434\u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u043C\u044B\u043C
    \u0437\u0430\u043A\u043E\u043D\u043E\u0434\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E\u043C.\r\n\r\n\u041F\u0440\u0430\u0432\u043E\u043E\u0431\u043B\u0430\u0434\u0430\u0442\u0435\u043B\u044C
    \u0442\u0430\u043A\u0436\u0435 \u0432\u043F\u0440\u0430\u0432\u0435 \u043F\u0440\u0438\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
    \u0438\u043B\u0438 \u043F\u0440\u0435\u043A\u0440\u0430\u0442\u0438\u0442\u044C
    \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0435 \u0444\u0443\u043D\u043A\u0446\u0438\u0438
    \u0421\u0435\u0440\u0432\u0438\u0441\u043E\u0432, \u0435\u0441\u043B\u0438 \u044D\u0442\u043E
    \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u0434\u043B\u044F
    \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u044F \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438,
    \u0437\u0430\u0449\u0438\u0442\u044B \u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442\u0443\u0430\u043B\u044C\u043D\u043E\u0439
    \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u0438,
    \u0441\u043E\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F \u0437\u0430\u043A\u043E\u043D\u043E\u0434\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430
    \u0438\u043B\u0438 \u0440\u0430\u0431\u043E\u0442\u044B \u0438\u043D\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u044B.\r\n\r\n\u041F\u0440\u0435\u043A\u0440\u0430\u0449\u0435\u043D\u0438\u0435
    \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0438 \u043D\u0435 \u043E\u0441\u0432\u043E\u0431\u043E\u0436\u0434\u0430\u0435\u0442
    \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u043E\u0442 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432
    \u0438 \u043F\u0440\u0430\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u043E
    \u0441\u0432\u043E\u0435\u0439 \u043F\u0440\u0438\u0440\u043E\u0434\u0435 \u0434\u043E\u043B\u0436\u043D\u044B
    \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0442\u044C\u0441\u044F \u043F\u043E\u0441\u043B\u0435
    \u043F\u0440\u0435\u043A\u0440\u0430\u0449\u0435\u043D\u0438\u044F \u0421\u043E\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u044F.\r\n\r\n17.
    \u0424\u041E\u0420\u0421-\u041C\u0410\u0416\u041E\u0420\r\n\r\n\u041F\u0440\u0430\u0432\u043E\u043E\u0431\u043B\u0430\u0434\u0430\u0442\u0435\u043B\u044C
    \u043D\u0435 \u043D\u0435\u0441\u0435\u0442 \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u0438
    \u0437\u0430 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0438 \u0438\u043B\u0438
    \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C
    \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432
    \u0432 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0435 \u043E\u0431\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u0441\u0442\u0432,
    \u043D\u0430\u0445\u043E\u0434\u044F\u0449\u0438\u0445\u0441\u044F \u0432\u043D\u0435
    \u0435\u0433\u043E \u0440\u0430\u0437\u0443\u043C\u043D\u043E\u0433\u043E \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044F,
    \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u0441\u0442\u0438\u0445\u0438\u0439\u043D\u044B\u0435
    \u0431\u0435\u0434\u0441\u0442\u0432\u0438\u044F, \u0432\u043E\u0439\u043D\u044B,
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
    \u043E\u0440\u0433\u0430\u043D\u043E\u0432, \u043F\u0435\u0440\u0435\u0431\u043E\u0438
    \u0438\u043D\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u044B,
    \u0441\u0431\u043E\u0438 \u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u0445
    \u0441\u0435\u0440\u0432\u0438\u0441\u043E\u0432, \u043E\u0442\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F
    \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u0441\u043D\u0430\u0431\u0436\u0435\u043D\u0438\u044F,
    \u043C\u0430\u0441\u0441\u043E\u0432\u044B\u0435 \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0441\u0431\u043E\u0438 \u0438 \u0438\u043D\u044B\u0435 \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0435
    \u043E\u0431\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430.\r\n\r\n18.
    \u0414\u0415\u041B\u0418\u041C\u041E\u0421\u0422\u042C \u041F\u041E\u041B\u041E\u0416\u0415\u041D\u0418\u0419\r\n\r\n\u0415\u0441\u043B\u0438
    \u043A\u0430\u043A\u043E\u0435-\u043B\u0438\u0431\u043E \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435
    \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E \u0421\u043E\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u044F
    \u0431\u0443\u0434\u0435\u0442 \u043F\u0440\u0438\u0437\u043D\u0430\u043D\u043E
    \u043D\u0435\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C,
    \u043D\u0435\u0437\u0430\u043A\u043E\u043D\u043D\u044B\u043C \u0438\u043B\u0438
    \u043D\u0435\u0438\u0441\u043F\u043E\u043B\u043D\u0438\u043C\u044B\u043C, \u0442\u0430\u043A\u043E\u0435
    \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0434\u043E\u043B\u0436\u043D\u043E
    \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0442\u044C\u0441\u044F \u0432 \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E
    \u0434\u043E\u043F\u0443\u0441\u0442\u0438\u043C\u043E\u0439 \u0437\u0430\u043A\u043E\u043D\u043E\u043C
    \u0441\u0442\u0435\u043F\u0435\u043D\u0438, \u0430 \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u0435\u0441\u044F
    \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0442
    \u0441\u0438\u043B\u0443.\r\n\r\n\u0415\u0441\u043B\u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435
    \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u043E\u0433\u043E \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u044F
    \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043E\u043D\u043E
    \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F \u0438\u0441\u043A\u043B\u044E\u0447\u0435\u043D\u043D\u044B\u043C
    \u0432 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0439 \u0441\u0442\u0435\u043F\u0435\u043D\u0438
    \u0431\u0435\u0437 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043E\u0442\u043C\u0435\u043D\u044B \u0432\u0441\u0435\u0433\u043E \u0421\u043E\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u044F.\r\n\r\n19.
    \u041E\u0422\u041A\u0410\u0417 \u041E\u0422 \u041F\u0420\u0410\u0412\r\n\r\n\u041D\u0435\u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435
    \u0438\u043B\u0438 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0430 \u041F\u0440\u0430\u0432\u043E\u043E\u0431\u043B\u0430\u0434\u0430\u0442\u0435\u043B\u044F
    \u0432 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u0435\u043D\u0438\u0438
    \u043A\u0430\u043A\u043E\u0433\u043E-\u043B\u0438\u0431\u043E \u043F\u0440\u0430\u0432\u0430
    \u043F\u043E \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u043C\u0443 \u0421\u043E\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u044E
