    \u0418\u041D\u0422\u0415\u041B\u041B\u0415\u041A\u0422\u0423\u0410\u041B\u042C\u041D\u0410\u042F
    \u0421\u041E\u0411\u0421\u0422\u0412\u0415\u041D\u041D\u041E\u0421\u0422\u042C\r\n\r\nWoolly
    Bunny \u0438 \u0432\u0441\u0435 \u0435\u0435 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B,
    \u0432\u043A\u043B\u044E\u0447\u0430\u044F, \u043F\u043E\u043C\u0438\u043C\u043E
    \u043F\u0440\u043E\u0447\u0435\u0433\u043E:\r\n\r\n1. \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u043D\u044B\u0439
    \u043A\u043E\u0434;\r\n2. \u0438\u0433\u0440\u043E\u0432\u043E\u0439 \u0434\u0438\u0437\u0430\u0439\u043D
    \u0438 \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0443;\r\n3. \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0435\u0439;\r\n4.
    \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F \u0438 \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F;\r\n5.
    \u0441\u044E\u0436\u0435\u0442 \u0438 \u0441\u0446\u0435\u043D\u0430\u0440\u0438\u0439;\r\n6.
    \u0434\u0438\u0430\u043B\u043E\u0433\u0438;\r\n7. \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F
    \u0438 \u0438\u043B\u043B\u044E\u0441\u0442\u0440\u0430\u0446\u0438\u0438;\r\n8.
    \u0430\u043D\u0438\u043C\u0430\u0446\u0438\u0438;\r\n9. \u043C\u0443\u0437\u044B\u043A\u0443
    \u0438 \u0437\u0432\u0443\u043A\u043E\u0432\u044B\u0435 \u044D\u0444\u0444\u0435\u043A\u0442\u044B;\r\n10.
    \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441;\r\n11. \u043B\u043E\u0433\u043E\u0442\u0438\u043F\u044B;\r\n12.
    \u0442\u043E\u0432\u0430\u0440\u043D\u044B\u0435 \u0437\u043D\u0430\u043A\u0438;\r\n13.
    \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B \u043E\u0444\u043E\u0440\u043C\u043B\u0435\u043D\u0438\u044F;\r\n14.
    \u0431\u0430\u0437\u044B \u0434\u0430\u043D\u043D\u044B\u0445 \u0438 \u0438\u043D\u044B\u0435
    \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B,\r\n\r\n\u0437\u0430\u0449\u0438\u0449\u0435\u043D\u044B
    \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u043C\u044B\u043C \u0437\u0430\u043A\u043E\u043D\u043E\u0434\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E\u043C
    \u043E\u0431 \u0430\u0432\u0442\u043E\u0440\u0441\u043A\u0438\u0445 \u043F\u0440\u0430\u0432\u0430\u0445,
