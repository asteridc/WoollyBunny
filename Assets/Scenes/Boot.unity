    \u041F\u0440\u0430\u0432\u043E\u043E\u0431\u043B\u0430\u0434\u0430\u0442\u0435\u043B\u0435\u043C
    \u0438\u043B\u0438 \u0437\u0430\u043A\u043E\u043D\u043E\u043C;\n\n4. \u0438\u0437\u0432\u043B\u0435\u043A\u0430\u0442\u044C,
    \u0434\u0435\u043A\u043E\u043C\u043F\u0438\u043B\u0438\u0440\u043E\u0432\u0430\u0442\u044C,
