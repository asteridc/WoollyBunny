--- !u!114 &1239252713
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1239252709}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ab4e3cca31ec2f845b660c0e40ccea61, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LocalizedText
  russianText: "\u0418\u0441\u0442\u043E\u0440\u0438\u044F \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0445\u0443\u0434\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
    \u0432\u044B\u043C\u044B\u0441\u043B\u043E\u043C. \u041E\u043D\u0430 \u0437\u0430\u0442\u0440\u0430\u0433\u0438\u0432\u0430\u0435\u0442
    \u0442\u0435\u043C\u044B \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438,
    \u043F\u043E\u0442\u0435\u0440\u0438 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044F,
    \u043D\u0430\u0441\u0438\u043B\u0438\u044F, \u0441\u043C\u0435\u0440\u0442\u0438,
    \u043F\u0441\u0438\u0445\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u0438 \u0441\u043B\u043E\u0436\u043D\u044B\u0445
    \u043C\u043E\u0440\u0430\u043B\u044C\u043D\u044B\u0445 \u0440\u0435\u0448\u0435\u043D\u0438\u0439.\n\n\u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0441\u0446\u0435\u043D\u044B \u043C\u043E\u0433\u0443\u0442 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0442\u044C
    \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0436\u0435\u0441\u0442\u043E\u043A\u043E\u0441\u0442\u0438,
    \u043A\u0440\u043E\u0432\u0438, \u0442\u0440\u0435\u0432\u043E\u0436\u043D\u044B\u0435
    \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438 \u0438 \u0434\u0440\u0443\u0433\u0438\u0435
    \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B, \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u044B\u0435
    \u0432\u044B\u0437\u0432\u0430\u0442\u044C \u044D\u043C\u043E\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439
    \u0434\u0438\u0441\u043A\u043E\u043C\u0444\u043E\u0440\u0442 \u0438\u043B\u0438
    \u0431\u044B\u0442\u044C \u0442\u044F\u0436\u0451\u043B\u044B\u043C\u0438 \u0434\u043B\u044F
    \u0432\u043E\u0441\u043F\u0440\u0438\u044F\u0442\u0438\u044F.\n\n\u041C\u044B
    \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u043C \u0438\u0433\u0440\u0430\u0442\u044C
    \u043E\u0441\u043E\u0437\u043D\u0430\u043D\u043D\u043E \u0438 \u0443\u0447\u0438\u0442\u044B\u0432\u0430\u0442\u044C
    \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435 \u044D\u043C\u043E\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0435
    \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435.\n\n\u0412\u0441\u0435
    \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0438, \u0441\u043E\u0431\u044B\u0442\u0438\u044F,
    \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438 \u0438 \u043C\u0435\u0441\u0442\u0430
    \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u0432\u044B\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u044B\u043C\u0438.
    \u041B\u044E\u0431\u044B\u0435 \u0441\u043E\u0432\u043F\u0430\u0434\u0435\u043D\u0438\u044F
    \u0441 \u0440\u0435\u0430\u043B\u044C\u043D\u043E \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u043C\u0438
    \u043B\u044E\u0434\u044C\u043C\u0438, \u0441\u043E\u0431\u044B\u0442\u0438\u044F\u043C\u0438
    \u0438\u043B\u0438 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u044F\u043C\u0438
    \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B.\n\n\n\n\n\u041D\u0430\u0436\u0438\u043C\u0430\u044F
    Enter, \u0432\u044B \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442\u0435,
    \u0447\u0442\u043E \u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u043B\u0438\u0441\u044C
    \u0441 \u0434\u0430\u043D\u043D\u044B\u043C \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435\u043C."
  englishText: 'This story is a work of fiction. It deals with themes of addiction,
    loss of control, violence, death, psychological distress, and difficult moral
    choices.


    Some scenes may contain depictions of violence, blood, disturbing
    situations, and other content that may cause emotional discomfort or be difficult
    to process.


    We recommend playing responsibly and being mindful of your
    own emotional well-being.


    All characters, events, organizations, and locations
    are fictional. Any resemblance to real people, events, or organizations is purely
    coincidental.





    By pressing Enter, you confirm that you have read and
    understood this warning.'
