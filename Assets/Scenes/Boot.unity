    \u0438\u0433\u0440\u0443 \u0438\u043B\u0438 \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u0443\u044E
    \u0432\u0430\u043C \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u044E \u0442\u0440\u0435\u0442\u044C\u0438\u043C
    \u043B\u0438\u0446\u0430\u043C;\r\n\r\n3. \u0438\u0437\u043C\u0435\u043D\u044F\u0442\u044C,
    \u0430\u0434\u0430\u043F\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C, \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0438\u0442\u044C,
    \u043F\u0435\u0440\u0435\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0442\u044C
    \u0438\u043B\u0438 \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0442\u044C \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u043D\u044B\u0435
    \u043F\u0440\u043E\u0438\u0437\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043D\u0430
    \u043E\u0441\u043D\u043E\u0432\u0435 \u0438\u0433\u0440\u044B, \u043A\u0440\u043E\u043C\u0435
    \u0441\u043B\u0443\u0447\u0430\u0435\u0432, \u043A\u043E\u0433\u0434\u0430 \u0442\u0430\u043A\u043E\u0435
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
