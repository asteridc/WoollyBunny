    \u0438\u043B\u0438 \u043A\u0430\u043A\u0438\u043C-\u043B\u0438\u0431\u043E \u0438\u043D\u044B\u043C
    \u0441\u043F\u043E\u0441\u043E\u0431\u043E\u043C \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u0438\u0437\u043E\u0432\u0430\u0442\u044C
