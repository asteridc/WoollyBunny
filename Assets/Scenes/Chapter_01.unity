  - text: "\u0412\u0441\u0435 \u0445\u0432\u0430\u043B\u0435\u043D\u043D\u044B\u0435
      \u043D\u0430\u0448\u0438 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0438
      \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B\u0438
      \u0444\u0443\u043D\u043A\u0446\u0438\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u0442\u044C.
      \u0412\u0441\u0435 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u044B\u0435
      \u0441\u0435\u0442\u0438 \u0432\u044B\u0432\u0435\u0434\u0435\u043D\u044B \u0438\u0437
      \u0441\u0442\u0440\u043E\u044F. \u0421\u0432\u0435\u0442\u0430 \u043D\u0435\u0442,
      \u0435\u0434\u044B \u0438 \u0432\u043E\u0434\u044B \u0442\u0430\u043A\u0436\u0435
      \u043D\u0435\u0442."
