  - text: "\u042F \u041A\u0435\u0440\u0435\u043C, \u043C\u0435\u0441\u0442\u043D\u044B\u0439
      \u0446\u0435\u0440\u0431\u0435\u0440. \u0417\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u0435
      \u044D\u0442\u043E \u0438\u043C\u044F, \u043F\u043E\u043A\u0430 \u043E\u043D\u043E
      \u043D\u0435 \u0441\u0442\u0430\u043B\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C,
      \u0447\u0442\u043E \u0432\u044B \u0443\u0441\u043B\u044B\u0448\u0430\u043B\u0438
      \u043F\u0435\u0440\u0435\u0434 \u0442\u0435\u043C, \u043A\u0430\u043A \u0432\u0430\u0441
      \u0432\u044B\u0448\u0432\u044B\u0440\u043D\u0443\u043B\u0438 \u043E\u0431\u0440\u0430\u0442\u043D\u043E."
