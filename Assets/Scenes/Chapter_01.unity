  - text: "\u0417\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u044C \u043D\u0435
      \u043E\u0442 \u043A\u0443\u0440\u0435\u043D\u0438\u044F \u0438\u043B\u0438
      \u0430\u043B\u043A\u043E\u0433\u043E\u043B\u044F, \u0430 \u043D\u0435\u0447\u0442\u043E
      \u0431\u043E\u043B\u0435\u0435 \u0441\u0435\u0440\u044C\u0435\u0437\u043D\u043E\u0433\u043E.
      \u041E\u0442 \u044D\u0442\u043E\u0433\u043E \u0437\u0430\u0432\u0438\u0441\u0438\u0442
      \u0432\u0441\u044F \u0436\u0438\u0437\u043D\u044C \u043D\u0430 \u0417\u0435\u043C\u043B\u0435,
      \u0432\u0441\u044F \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u0430, \u0432\u0441\u0435
      \u0440\u0430\u0437\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u044F, \u0432\u0441\u0435
      \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u044B, \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u044F\u0449\u0438\u0435
      \u043D\u0430 \u043F\u043B\u0430\u043D\u0435\u0442\u0435 \u0437\u0430\u0432\u044F\u0437\u0430\u043D\u044B
      \u043D\u0430 \u043E\u0434\u043D\u043E\u0439 \u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438, - \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u0435."
