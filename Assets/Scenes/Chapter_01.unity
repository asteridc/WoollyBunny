  - text: "\xAB\u041A\u0430\u043A \u0433\u0440\u0443\u0441\u0442\u043D\u043E... \u041D\u0430\u0434\u0435\u044E\u0441\u044C,
      \u0435\u0433\u043E \u0434\u043E\u0447\u044C \u0432\u0441\u0451 \u0435\u0449\u0451
      \u0436\u0438\u0432\u0430.\xBB"
    speakerName: "\u0418\u043B\u0430\u0439"
    characterName: "\u0418\u043B\u0430\u0439"
    changeSpeakerName: 1
    changeCharacterSprite: 1
    changeBackground: 0
    characterSprite: {fileID: 21300000, guid: 2c219a8a9305a5c49b3dd8d87684166c, type: 3}
    backgroundSprite: {fileID: 21300000, guid: 24f2cb8f49005f84e98a8e8943475b2b, type: 3}
    isOnRight: 0
    flipSpeakerImage: 0
    listenerCharacterName: 
    isListenerOnRight: 0
    flipListenerImage: 0
    showCollectibleView: 1
    collectibleTitle: "\u041F\u0440\u043E\u0449\u0430\u0439, \u0434\u043E\u0447\u043A\u0430..."
    collectibleContent: "\u041F\u0440\u043E\u0441\u0442\u0438, \u0447\u0442\u043E
      \u043D\u0435 \u0434\u043E\u0436\u0434\u0430\u043B\u0441\u044F. \u042F \u0431\u043E\u043B\u044C\u0448\u0435
      \u0442\u0430\u043A \u043D\u0435 \u043C\u043E\u0433\u0443... \u041E\u0441\u0442\u0430\u043B\u043E\u0441\u044C
      \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u043D\u043E \u2014 \u043F\u043E\u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F
      \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u0434\u043E \u0442\u0435\u0445,
      \u043A\u0442\u043E \u0432\u0441\u0451 \u0435\u0449\u0451 \u0432\u043E \u0447\u0442\u043E-\u0442\u043E
      \u0432\u0435\u0440\u0438\u0442 \u043D\u0430 \u044D\u0442\u043E\u0439 \u0431\u043E\u0433\u043E\u043C
      \u0437\u0430\u0431\u044B\u0442\u043E\u0439 \u043F\u043B\u0430\u043D\u0435\u0442\u0435.
      \u041F\u043E\u043C\u043D\u0438\u0448\u044C, \u043C\u044B \u043F\u0440\u044F\u0442\u0430\u043B\u0438
      \u0435\u0434\u0443 \u0432 \u0442\u043E\u043C \u044F\u0449\u0438\u043A\u0435?.
      \u0412 \u0442\u043E\u043C, \u0433\u0434\u0435 \u0446\u0438\u0444\u0440\u044B.
      \u042F \u043F\u043E\u043C\u043D\u044E \u0442\u0443 \u0434\u0430\u0442\u0443,
      18 \u044F\u043D\u0432\u0430\u0440\u044F, \u0442\u043E\u0442 \u0434\u0435\u043D\u044C,
      \u043A\u043E\u0433\u0434\u0430 \u0442\u044B \u043F\u0435\u0440\u0432\u044B\u0439
      \u0440\u0430\u0437 \u0441\u043A\u0430\u0437\u0430\u043B\u0430... \"\u043F\u0430\u043F\u0430\"...
      \u0422\u0430\u043A\u043E\u0432 \u0438 \u043A\u043E\u0434.\r\n\r\n\u0415\u0441\u043B\u0438
      \u0442\u044B \u043D\u0430\u0439\u0434\u0451\u0448\u044C \u044D\u0442\u043E
      \u2014 \u0432\u043E\u0437\u044C\u043C\u0438 \u043A\u0430\u0440\u0442\u0443.
      \u041E\u043D\u0430 \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u0438\u0432\u0435\u0441\u0442\u0438
      \u0442\u0435\u0431\u044F \u043A \u043D\u0438\u043C. \u0418\u043B\u0438 \u0445\u043E\u0442\u044F
      \u0431\u044B \u043A \u043F\u043E\u043A\u043E\u044E.\r\n\r\n\u042F \u0443\u0441\u0442\u0430\u043B.
      \u041F\u0440\u043E\u0441\u0442\u0438."
    collectibleIcon: {fileID: 21300000, guid: a42c8ec0ff27c024fab127cffe55cef1, type: 3}
    showItemNotification: 1
    itemName: "\u041F\u0440\u043E\u0449\u0430\u0439, \u0434\u043E\u0447\u043A\u0430..."
    itemType: "\u041A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u043E\u043D\u043D\u044B\u0439
