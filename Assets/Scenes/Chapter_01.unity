  - text: "\u0425\u0430\u043D\u043D\u0430 \u043D\u0435 \u0437\u043D\u0430\u043B\u0430,
      \u043A\u0430\u043A \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u0442\u044C
      \u0441\u0432\u043E\u0435\u0433\u043E \u043D\u0430\u043F\u0430\u0440\u043D\u0438\u043A\u0430,
      \u0432\u0435\u0434\u044C \u0435\u0451 \u0441\u0430\u043C\u0443 \u043D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043B.
      \u041D\u043E \u043D\u0435\u0437\u043D\u0430\u043D\u0438\u0435 \u043D\u0435
      \u0441\u043F\u0430\u0441\u0430\u043B\u043E \u0435\u0451 \u043E\u0442 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0439
      \u0431\u043E\u043B\u0438, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0442\u0430\u043A
      \u0436\u0435, \u043A\u0430\u043A \u0438 \u0443 \u0418\u043B\u0430\u044F, \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u043B\u0430
      \u043F\u0440\u0435\u043B\u043E\u043C\u0438\u0442\u044C\u0441\u044F \u043A \u0437\u0435\u043C\u043B\u0435
      \u0432 \u0434\u0438\u043A\u043E\u043C \u043E\u0442\u0447\u0430\u044F\u043D\u0438\u0438."
