  - text: "\u0412\u043D\u0443\u0442\u0440\u0438 - \u043F\u043E\u043B\u0443\u043C\u0440\u0430\u043A,
      \u043F\u0435\u0440\u0435\u0431\u0438\u0442\u044B\u0435 \u043F\u0430\u043D\u0435\u043B\u0438,
      \u043C\u0438\u0433\u0430\u044E\u0449\u0438\u0435 \u0438\u043D\u0434\u0438\u043A\u0430\u0442\u043E\u0440\u044B.
      \u0418 \u0433\u0434\u0435-\u0442\u043E \u0432 \u0433\u043B\u0443\u0431\u0438\u043D\u0435
      - \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u044F\u0437\u0432\u0430, \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043D\u0443\u0436\u043D\u043E
      \u0431\u044B\u043B\u043E \u0432\u044B\u0440\u0435\u0437\u0430\u0442\u044C."
    speakerName: ...
    characterName: ...
