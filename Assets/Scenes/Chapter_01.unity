  transparent: {fileID: 21300000, guid: 5d44efab882a8bb49ac93d70eb8dddc4, type: 3}
  eliSprite: {fileID: 21300000, guid: 267040e7d7af55d49acbdc19cd3c3bc5, type: 3}
  kaneSprite: {fileID: 21300000, guid: 2c219a8a9305a5c49b3dd8d87684166c, type: 3}
  hannaSprite: {fileID: 21300000, guid: d6f923f5e7c8f4147bb2e28b487fed4c, type: 3}
  firstAssasinPeacekeeper: {fileID: 21300000, guid: a9695eadc3a7abc48addb1180a23f208, type: 3}
  choicesContainer: {fileID: 380252224}
  choiceButtonPrefab: {fileID: 9006469527954897273, guid: 6532b2ffe75e48c40a95081ee5927996, type: 3}
  codePanelController: {fileID: 1359917872}
  codePanelUI: {fileID: 1771563315}
  itemManager: {fileID: 1710625757}
  storyNotificationPanel: {fileID: 1041379836}
  storyNotificationText: {fileID: 0}
  storyNotificationIcon: {fileID: 0}
  collectiblePanel: {fileID: 1811805671}
  collectibleTitleText: {fileID: 1759159454}
  collectibleContentText: {fileID: 848434150}
  collectibleIconImage: {fileID: 60490458}
  collectibleCloseButton: {fileID: 1443352887}
  lines:
  - text: "\u0418\u0441\u0442\u043E\u0440\u0438\u044F \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0445\u0443\u0434\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
      \u0432\u044B\u043C\u044B\u0441\u043B\u043E\u043C. \u041E\u043D\u0430 \u043A\u0430\u0441\u0430\u0435\u0442\u0441\u044F
      \u0442\u0435\u043C \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438,
      \u043F\u043E\u0442\u0435\u0440\u0438 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044F
      \u0438 \u0441\u043B\u043E\u0436\u043D\u044B\u0445 \u043C\u043E\u0440\u0430\u043B\u044C\u043D\u044B\u0445
      \u0440\u0435\u0448\u0435\u043D\u0438\u0439. \u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0441\u0446\u0435\u043D\u044B \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C
      \u0442\u044F\u0436\u0435\u043B\u044B\u043C\u0438 \u0434\u043B\u044F \u0432\u043E\u0441\u043F\u0440\u0438\u044F\u0442\u0438\u044F.
      \u041C\u044B \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u043C
      \u0438\u0433\u0440\u0430\u0442\u044C \u043E\u0441\u043E\u0437\u043D\u0430\u043D\u043D\u043E.
      \u041F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0438 \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
      \u0432\u044B\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u044B\u043C\u0438, \u0432\u0441\u0435
      \u0441\u043E\u0432\u043F\u0430\u0434\u0435\u043D\u0438\u044F \u0441 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E
      \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B."
    index: 1
    speakerName: "\u0414\u0438\u0441\u043A\u043B\u0435\u0439\u043C\u0435\u0440"
    characterName: "\u0414\u0438\u0441\u043A\u043B\u0435\u0439\u043C\u0435\u0440"
    changeSpeakerName: 1
    changeCharacterSprite: 0
    changeBackground: 0
    characterSprite: {fileID: 21300000, guid: 5d44efab882a8bb49ac93d70eb8dddc4, type: 3}
    backgroundSprite: {fileID: 21300000, guid: 24f2cb8f49005f84e98a8e8943475b2b, type: 3}
    isOnRight: 0
    flipSpeakerImage: 0
    listenerCharacterName: 
    isListenerOnRight: 0
    flipListenerImage: 0
    showCollectibleView: 0
    collectibleTitle: 
    collectibleContent: 
    collectibleIcon: {fileID: 0}
    showItemNotification: 0
    itemName: 
    itemType: 
    itemRarity: 0
    itemIcon: {fileID: 0}
    isJumpLine: 0
    gotoLineIndex: 0
    hasChoices: 0
    hasPathConsequences: 0
    pathVarients: []
    choices: []
    extraActions:
      showCodePanel: 0
      showNotePanel: 0
      stopDialogueAfterThisLine: 0
      objectToActivate: {fileID: 0}
  - text: "\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u0441\u0435\u0431\u0435
      \u0432\u0441\u0435\u043E\u0431\u0449\u0438\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438\u0439
      \u043A\u043E\u043B\u043B\u0430\u043F\u0441, \u0432\u044B\u0437\u0432\u0430\u043D\u043D\u044B\u0439
      \u043E\u0441\u0442\u0440\u043E\u0439 \u043B\u043E\u043C\u043A\u043E\u0439,
      - \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u044C\u044E."
