  - text: "\u0412\u0441\u0435 \u0432\u044B \u0442\u0430\u043A \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435,
      \u0432\u044B\u0436\u0438\u0432\u0430\u043B\u044C\u0449\u0438\u043A\u0438, \u0431\u043B\u0438\u043D.
      \u0410 \u043F\u043E\u0442\u043E\u043C \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430
      \u0438\u0437 \u0432\u0430\u0441 \u0442\u0432\u043E\u0440\u0438\u0442 \u043F\u043E\u043B\u043D\u0435\u0439\u0448\u0443\u044E
