  - text: "\u0418\u043B\u0430\u0439 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B
      \u0433\u043E\u043B\u043E\u0432\u0443 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u0425\u0430\u043D\u043D\u044B. \u041E\u043D\u0430 \u0441\u0434\u0435\u043B\u0430\u043B\u0430
      \u0442\u043E \u0436\u0435 \u0441\u0430\u043C\u043E\u0435. \u041E\u043D\u0438
      \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0438\u0441\u044C \u0432\u0437\u0433\u043B\u044F\u0434\u0430\u043C\u0438,
      \u0438 \u0432 \u044D\u0442\u043E\u0442 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439
      \u043C\u0438\u0433 \u0418\u043B\u0430\u0439 \u0443\u0432\u0438\u0434\u0435\u043B,
      \u0447\u0435\u0433\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0442\u043E\u0438\u0442
      \u0435\u0451 \u043D\u0435\u0432\u0438\u043D\u043D\u044B\u0439 \u0432\u0437\u0433\u043B\u044F\u0434."
