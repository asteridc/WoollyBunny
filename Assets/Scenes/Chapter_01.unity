  - text: "\u0418\u043B\u0430\u0439 \u0431\u0440\u043E\u0434\u0438\u043B \u043F\u043E
      \u044D\u0442\u0430\u0436\u0443 \u043E\u043A\u043E\u043B\u043E \u0434\u0435\u0441\u044F\u0442\u0438
      \u043C\u0438\u043D\u0443\u0442, \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u044B\u0435
      \u043B\u0443\u0447\u0438 \u0443\u0445\u043E\u0434\u044F\u0449\u0435\u0433\u043E
      \u0441\u043E\u043B\u043D\u0446\u0430 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u0438\u0441\u044C
      \u0438\u0437-\u0437\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430.
      \u0418 \u043E\u043D\u0438 \u043E\u0441\u0432\u0435\u0442\u0438\u043B\u0438
      \u0431\u0443\u043C\u0430\u0436\u043D\u044B\u0439 \u043B\u0438\u0441\u0442,
      \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0431\u044B\u043B\u043E
      \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043E \u0447\u0442\u043E-\u0442\u043E
      \u0432\u0440\u043E\u0434\u0435 \u043F\u0440\u043E\u0449\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u043F\u0438\u0441\u044C\u043C\u0430."
