      showNotePanel: 0
      stopDialogueAfterThisLine: 0
      objectToActivate: {fileID: 0}
  - text: "\u0412\u0435\u0442\u0435\u0440 \u0432 \u043A\u0440\u043E\u043D\u0430\u0445
      \u0434\u0443\u0431\u0430, \u043F\u043E\u0442\u0440\u0435\u0441\u043A\u0438\u0432\u0430\u043D\u0438\u0435
      \u043A\u0430\u043C\u043D\u0435\u0439 - \u0432\u0441\u0451, \u0447\u0442\u043E
