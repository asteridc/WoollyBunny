  - text: "\u041D\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u043E
      \u0434\u0430\u0436\u0435 \u043F\u0440\u0438 \u0442\u0430\u043A\u0438\u0445
      \u043E\u0431\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430\u0445
      \u0436\u0430\u0434\u043D\u043E \u0446\u0435\u043F\u043B\u044F\u0435\u0442\u0441\u044F
      \u0437\u0430 \u043A\u0430\u0436\u0434\u0443\u044E \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C
      \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F \u043D\u0430 \u0417\u0435\u043C\u043B\u0435
      \u0434\u043E\u043B\u044C\u0448\u0435 \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u043E\u0433\u043E."
