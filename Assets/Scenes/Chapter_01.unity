  - text: "\u0425\u0430\u043D\u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u043B\u0430
      \u0434\u0432\u0435\u0440\u044C, \u0438 \u043D\u0430 \u043D\u0438\u0445 \u0434\u043E\u0445\u043D\u0443\u043B
      \u0433\u043E\u0440\u044F\u0447\u0438\u0439 \u0432\u043E\u0437\u0434\u0443\u0445.
      \u0417\u0430\u043F\u0430\u0445 \u043F\u043B\u0430\u0432\u043B\u0435\u043D\u043E\u0439
      \u0438\u0437\u043E\u043B\u044F\u0446\u0438\u0438, \u0433\u0430\u0440\u0438,
      \u0440\u0436\u0430\u0432\u043E\u0433\u043E \u043C\u0435\u0442\u0430\u043B\u043B\u0430."
    speakerName: ...
    characterName: ...
