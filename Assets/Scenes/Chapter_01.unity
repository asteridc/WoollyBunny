  m_text: "\u0418\u0441\u0442\u043E\u0440\u0438\u044F \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0445\u0443\u0434\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
    \u0432\u044B\u043C\u044B\u0441\u043B\u043E\u043C. \u041E\u043D\u0430 \u043A\u0430\u0441\u0430\u0435\u0442\u0441\u044F
    \u0442\u0435\u043C \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438,
    \u043F\u043E\u0442\u0435\u0440\u0438 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044F
    \u0438 \u0441\u043B\u043E\u0436\u043D\u044B\u0445 \u043C\u043E\u0440\u0430\u043B\u044C\u043D\u044B\u0445
    \u0440\u0435\u0448\u0435\u043D\u0438\u0439. \u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0441\u0446\u0435\u043D\u044B \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C
    \u0442\u044F\u0436\u0435\u043B\u044B\u043C\u0438 \u0434\u043B\u044F \u0432\u043E\u0441\u043F\u0440\u0438\u044F\u0442\u0438\u044F.
    \u041C\u044B \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u043C
    \u0438\u0433\u0440\u0430\u0442\u044C \u043E\u0441\u043E\u0437\u043D\u0430\u043D\u043D\u043E.
    \u041F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0438 \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
    \u0432\u044B\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u044B\u043C\u0438, \u0432\u0441\u0435
    \u0441\u043E\u0432\u043F\u0430\u0434\u0435\u043D\u0438\u044F \u0441 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E
    \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B."
