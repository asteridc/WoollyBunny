  - text: "\u0418\u043B\u0430\u0439 \u043D\u0435 \u0437\u043D\u0430\u043B, \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043C\u0443\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u0430 \u0431\u044B\u043B\u0430
      \u0435\u0433\u043E \u0441\u043C\u0435\u0440\u0442\u044C. \u041C\u0435\u0440\u0442\u0432\u043E\u0435
      \u0442\u0435\u043B\u043E \u0434\u0440\u0443\u0433\u0430, \u0438\u0437 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u043B\u0430 \u0431\u0440\u044B\u0437\u0433\u0430\u0442\u044C
      \u043A\u0440\u043E\u0432\u044C, \u0437\u0430\u0441\u0442\u044B\u043B\u043E
      \u043F\u0435\u0440\u0435\u0434 \u0433\u043B\u0430\u0437\u0430\u043C\u0438 \u0438
      \u043F\u0440\u0438\u0442\u044F\u043D\u0443\u043B\u043E \u043A \u0441\u0435\u0431\u0435
      \u0432\u0441\u0435 \u0441\u0443\u0449\u0435\u0435 \u0432\u043E\u043A\u0440\u0443\u0433
