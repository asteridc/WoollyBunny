    weaponNameEn: Raven's song
    icon: {fileID: 21300000, guid: 41990ae6e78e0a5418208a909ec9eb15, type: 3}
    typeRu: "\u0421\u043D. \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0430"
    typeEn: Rifle
    rarityRu: "\u042D\u043F\u0438\u0447\u0435\u0441\u043A\u0438\u0439"
