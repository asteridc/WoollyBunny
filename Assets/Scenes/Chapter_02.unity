  m_text: "\u0427\u0442\u043E\u0431\u044B \u043F\u043E\u0447\u0438\u043D\u0438\u0442\u044C
    \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440 \u0432 \u043F\u043E\u0434\u0441\u0442\u0430\u043D\u0446\u0438\u0438,
    \u0432\u0430\u043C \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
    \u0441\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u0446\u0435\u043F\u043E\u0447\u043A\u0443 \u0438\u0437 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0445
    \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u043E\u0432 \u0432
    \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0439 \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438.
    \u0415\u0441\u043B\u0438 \u043C\u043D\u043E\u0433\u043E \u0440\u0430\u0437 \u043E\u0448\u0438\u0431\u0451\u0442\u0435\u0441\u044C
    - \u0443\u043C\u0440\u0451\u0442\u0435."
