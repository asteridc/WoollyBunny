    - target: {fileID: 7948586094568331592, guid: cfeb5eabac51df642accec56bd63ffbe, type: 3}
      propertyPath: englishText
      value: 'The primary currency of New World. It inherited its value and reliability
        from the long-forgotten dollar. With enough of it, you can buy almost anything.


        Almost.'
      objectReference: {fileID: 0}
    - target: {fileID: 7948586094568331592, guid: cfeb5eabac51df642accec56bd63ffbe, type: 3}
      propertyPath: russianText
      value: "\u041E\u0441\u043D\u043E\u0432\u043D\u0430\u044F \u0432\u0430\u043B\u044E\u0442\u0430
        \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E \u0433\u043E\u0440\u043E\u0434\u0430.
        \u0423\u043D\u0430\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B\u0430
        \u0441\u0432\u043E\u044E \u0446\u0435\u043D\u043D\u043E\u0441\u0442\u044C
        \u0438 \u043D\u0430\u0434\u0435\u0436\u043D\u043E\u0441\u0442\u044C \u043E\u0442
        \u0434\u0430\u0432\u043D\u043E \u0437\u0430\u0431\u044B\u0442\u043E\u0433\u043E
        \u0434\u043E\u043B\u043B\u0430\u0440\u0430. \u041D\u0430 \u044D\u0442\u0438
        \u0434\u0435\u043D\u044C\u0433\u0438 \u043C\u043E\u0436\u043D\u043E \u043A\u0443\u043F\u0438\u0442\u044C
        \u0432\u0441\u0435.\n\n\u0418\u043B\u0438.. \u043F\u043E\u0447\u0442\u0438
        \u0432\u0441\u0435."
      objectReference: {fileID: 0}
