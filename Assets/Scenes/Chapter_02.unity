    - target: {fileID: 1255120884401598652, guid: be9652d8045824b4c88e74d22dc29b84, type: 3}
      propertyPath: englishText
      value: Each pellet has a 50% chance to ricochet and hit a nearby enemy, dealing
        80% less damage.
      objectReference: {fileID: 0}
    - target: {fileID: 1255120884401598652, guid: be9652d8045824b4c88e74d22dc29b84, type: 3}
      propertyPath: russianText
      value: "\u0421 \u0448\u0430\u043D\u0441\u043E\u043C 50% \u043E\u0434\u043D\u0430
        \u0438\u0437 \u0434\u0440\u043E\u0431\u0435\u0439 \u0440\u0438\u043A\u043E\u0448\u0435\u0442\u0438\u0442
        \u0438 \u043F\u043E\u0440\u0430\u0436\u0430\u0435\u0442 \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u0433\u043E
        \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430, \u043D\u0430\u043D\u043E\u0441\u044F
        \u043D\u0430 80% \u043C\u0435\u043D\u044C\u0448\u0435 \u0443\u0440\u043E\u043D\u0430."
      objectReference: {fileID: 0}
    - target: {fileID: 1494990909483315104, guid: be9652d8045824b4c88e74d22dc29b84, type: 3}
      propertyPath: m_Name
      value: "\u043A\u0430\u0440\u0442\u0430 (\u041F\u043E\u043F\u0440\u044B\u0433\u0443\u043D\u0447\u0438\u043A)"
      objectReference: {fileID: 0}
    - target: {fileID: 1511854449278106621, guid: be9652d8045824b4c88e74d22dc29b84, type: 3}
      propertyPath: m_text
      value: "\u0421 \u0448\u0430\u043D\u0441\u043E\u043C 50% \u0434\u0440\u043E\u0431\u044C
        (\u043B\u044E\u0431\u0430\u044F \u0438\u0437 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0438\u0432\u0448\u0435\u0439)
        \u0440\u0438\u043A\u043E\u0448\u0435\u0442\u0438\u0442 \u0438 \u043D\u0430\u043D\u043E\u0441\u0438\u0442
        \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u043C \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430\u043C
        \u043D\u0430 80% \u043C\u0435\u043D\u044C\u0448\u0435 \u0443\u0440\u043E\u043D\u0430."
      objectReference: {fileID: 0}
