  m_Script: {fileID: 11500000, guid: ab4e3cca31ec2f845b660c0e40ccea61, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  russianText: "\u041F\u0440\u043E\u0433\u0440\u0435\u0441\u0441 \u043D\u0430 \u0434\u0430\u043D\u043D\u043E\u043C
    \u0441\u043B\u043E\u0442\u0435 \u0431\u044B\u043B \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D
    \u0432 \u0434\u0440\u0443\u0433\u043E\u0439 \u043B\u043E\u043A\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0438.
    \u041F\u0440\u0438 \u0437\u0430\u0433\u0440\u0443\u0437\u043A\u0435 \u044F\u0437\u044B\u043A
    \u0438\u0433\u0440\u044B \u0431\u0443\u0434\u0435\u0442 \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0435\u043D
    \u043D\u0430 \u044F\u0437\u044B\u043A, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u0432 \u044D\u0442\u043E\u043C \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0438.\r\n\r\n\u0417\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C
    \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435?"
  englishText: 'Progress in this slot was saved in a different localization. When
    you load it, the game language will switch to the language used for this save.


    Load
    this save?'
