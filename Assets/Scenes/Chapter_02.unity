--- !u!114 &790250674
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 790250672}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041E\u0442: \u041C\u0438\u0440\u0435\u043B\u044C \u0414\u0435\u2019\u041B\u0430\u043C\u043E\r\n\u041A\u043E\u043C\u0443:
    \u0418\u043B\u0430\u0439 \u0425\u0430\u0440\u0440\u0435\u0434\r\n\r\n\xAB\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439,
    \u0434\u043E\u0440\u043E\u0433\u043E\u0439 \u043F\u043B\u0435\u043C\u044F\u043D\u043D\u0438\u043A.\r\n\r\n\u042F
    \u043D\u0435 \u0445\u043E\u0447\u0443 \u0442\u044F\u043D\u0443\u0442\u044C \u0441
    \u044D\u0442\u0438\u043C, \u043D\u0435 \u043C\u043E\u0433\u0443 \u0434\u0435\u0440\u0436\u0430\u0442\u044C
    \u0442\u0430\u043A\u043E\u0435 \u0432 \u0441\u0435\u0431\u0435\u2026 \u0422\u0432\u043E\u0438
    \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0438 \u043C\u0435\u0440\u0442\u0432\u044B.
    \u041E\u043D\u0438 \u043F\u043E\u0433\u0438\u0431\u043B\u0438 \u0432 \u0430\u0432\u0438\u0430\u043A\u0430\u0442\u0430\u0441\u0442\u0440\u043E\u0444\u0435.
    \u042F \u0431\u044B\u043B\u0430 \u0443\u0434\u0438\u0432\u043B\u0435\u043D\u0430,
    \u0447\u0442\u043E \u0442\u044B \u0431\u044B\u043B \u043D\u0435 \u0441 \u043D\u0438\u043C\u0438.
    \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u044F \u043F\u043E\u0434\u0443\u043C\u0430\u043B\u0430,
    \u0447\u0442\u043E \u0442\u044B \u0447\u0443\u0434\u043E\u043C \u0432\u044B\u0436\u0438\u043B,
    \u043D\u043E \u0442\u044B \u0431\u044B\u043B \u0432 \u043E\u0441\u0442\u0440\u043E\u0439
    \u0437\u043E\u043D\u0435 \u0422\u0435\u043C\u043D\u043E\u0433\u043E \u0434\u043D\u044F
    \u0432 \u0442\u043E \u0432\u0440\u0435\u043C\u044F.\r\n\r\n\u041A\u043E\u0433\u0434\u0430
    \u0440\u0435\u0439\u0441, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0438\u0441\u044C
    \u0442\u0432\u043E\u0438 \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0438, \u043F\u043E\u0442\u0435\u0440\u044F\u043B
    \u0441\u0432\u044F\u0437\u044C \u0441 \u0431\u0430\u0437\u043E\u0439, \u0438\u043C\u2026
    \u043D\u0435 \u043F\u043E\u0432\u0435\u0437\u043B\u043E: \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E
    \u0441\u0442\u043E\u043B\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u0435 \u0434\u0432\u0443\u0445
    \u0440\u0435\u0439\u0441\u043E\u0432. \u0412\u0442\u043E\u0440\u043E\u0439 \u0440\u0435\u0439\u0441
    \u0441\u043F\u0430\u0441\u0441\u044F, \u043F\u0440\u0438\u0437\u0435\u043C\u043B\u0438\u0432\u0448\u0438\u0441\u044C
    \u043D\u0430 \u043E\u0441\u0442\u0440\u043E\u0432. \u041C\u043D\u0435 \u043E\u0447\u0435\u043D\u044C
    \u0436\u0430\u043B\u044C, \u0447\u0442\u043E \u0442\u0430\u043A \u0432\u0441\u0435
    \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C\u2026 \u0418\u0437\u0432\u0438\u043D\u0438,
    \u0447\u0442\u043E \u0441\u043E\u043E\u0431\u0449\u0438\u043B\u0430 \u043D\u0435
    \u0441\u0440\u0430\u0437\u0443\u2026\r\n\r\n\u0417\u043D\u0430\u0439, \u0447\u0442\u043E
    \u0435\u0441\u043B\u0438 \u0441\u0443\u0434\u044C\u0431\u0430 \u0441\u044B\u0433\u0440\u0430\u0435\u0442
    \u0432 \u0442\u0432\u043E\u044E \u043F\u043E\u043B\u044C\u0437\u0443, \u0438
    \u043C\u044B \u0441\u043C\u043E\u0436\u0435\u043C \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C\u0441\u044F,
    \u044F \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u0443\u0434\u0443 \u0440\u0430\u0434\u0430
    \u0442\u0432\u043E\u0435\u043C\u0443 \u043F\u0440\u0438\u0445\u043E\u0434\u0443.\r\n\r\n\u0422\u0435\u0442\u0443\u0448\u043A\u0430
    \u041C\u0438\u0440\u0430\xBB\r"
  m_isRightToLeft: 0
