    headMultiplier: 1.8
    torsoMultiplier: 0.8
    armsMultiplier: 0.75
    legsMultiplier: 0.75
    moduleCount: 3
    descriptionRu: "\u042D\u0442\u0430 \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0430
      \u0445\u0440\u0430\u043D\u0438\u0442 \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u0443\u044E
      \u0442\u0430\u0439\u043D\u0443 \u2014 \u043D\u0438\u043A\u0442\u043E \u043D\u0435
      \u0437\u043D\u0430\u0435\u0442, \u043E\u0442\u043A\u0443\u0434\u0430 \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
      \u043D\u043E\u0432\u044B\u0435 \u043F\u0430\u0442\u0440\u043E\u043D\u044B \u0432
      \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435..."
    descriptionEn: "This rifle holds a closely guarded secret \u2014 no one knows
      where the new rounds in its magazine come from..."
