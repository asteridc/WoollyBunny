    - target: {fileID: 3892373169966012866, guid: 19931da71a2a5d44a869b0040f013f0d, type: 3}
      propertyPath: russianText
      value: "\u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u0438
        \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0433\u043E \u043E\u0440\u0443\u0436\u0438\u044F"
      objectReference: {fileID: 0}
    - target: {fileID: 4481249929881861953, guid: 19931da71a2a5d44a869b0040f013f0d, type: 3}
      propertyPath: m_text
      value: "\u0423 \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0433\u043E \u043E\u0440\u0443\u0436\u0438\u044F
        \u0435\u0441\u0442\u044C \u043E\u0442\u043B\u0438\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
        \u044D\u043B\u0435\u043C\u0435\u043D\u0442 \u2014 \u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u0438.\n\n\u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u0438
        \u0437\u0430\u0432\u0438\u0441\u044F\u0442 \u043E\u0442 \u0441\u0442\u0438\u043B\u044F
        \u043E\u0440\u0443\u0436\u0438\u044F. \u042F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
        \u043F\u0430\u0441\u0441\u0438\u0432\u043D\u044B\u043C\u0438 \u043D\u0430\u0432\u044B\u043A\u0430\u043C\u0438,
        \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043D\u0435 \u0443\u043B\u0443\u0447\u0448\u0430\u044E\u0442\u0441\u044F.\n"
      objectReference: {fileID: 0}
    - target: {fileID: 4481249929881861953, guid: 19931da71a2a5d44a869b0040f013f0d, type: 3}
      propertyPath: m_margin.w
