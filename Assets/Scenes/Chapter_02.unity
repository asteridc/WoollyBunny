    - target: {fileID: 1255120884401598652, guid: be9652d8045824b4c88e74d22dc29b84, type: 3}
      propertyPath: englishText
      value: Each enemy killed increases the number of pellets fired per shot. Starts
        at 8 pellets, up to a maximum of 12.
      objectReference: {fileID: 0}
    - target: {fileID: 1255120884401598652, guid: be9652d8045824b4c88e74d22dc29b84, type: 3}
      propertyPath: russianText
      value: "\u041A\u0430\u0436\u0434\u044B\u0439 \u0443\u0431\u0438\u0442\u044B\u0439
        \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A \u0432 \u0431\u043E\u044E
        \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
        \u0434\u0440\u043E\u0431\u0435\u0439, \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0438\u0432\u0430\u044E\u0449\u0438\u0445
        \u0437\u0430 \u0440\u0430\u0437. \u0418\u0437\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0435
        \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u2014 8, \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0435
        \u2014 12."
      objectReference: {fileID: 0}
    - target: {fileID: 1494990909483315104, guid: be9652d8045824b4c88e74d22dc29b84, type: 3}
      propertyPath: m_Name
      value: "\u043A\u0430\u0440\u0442\u0430 (\u041A\u0430\u0440\u0442\u0435\u0447\u044C)"
      objectReference: {fileID: 0}
    - target: {fileID: 1511854449278106621, guid: be9652d8045824b4c88e74d22dc29b84, type: 3}
      propertyPath: m_text
      value: "\u041A\u0430\u0436\u0434\u044B\u0439 \u0443\u0431\u0438\u0442\u044B\u0439
        \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A \u0432 \u0431\u043E\u044E
        \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
