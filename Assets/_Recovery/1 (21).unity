    - target: {fileID: 5108385095289746874, guid: dc84b53fcf6897e4e9325e5f5dc41cd9, type: 3}
      propertyPath: m_text
      value: "\u0412\u044B\u0441\u0442\u0440\u0435\u043B \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0430,
        \u043D\u0430\u043D\u043E\u0441\u044F\u0449\u0438\u0439 \u043B\u0435\u0442\u0430\u043B\u044C\u043D\u044B\u0439
        \u0443\u0440\u043E\u043D \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0443,
        \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044E\u0442
        \u0418\u043B\u0430\u044E 10% \u043E\u0442 \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E
        \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F. \u0415\u0441\u043B\u0438
        \u0432\u044B\u0441\u0442\u0440\u0435\u043B \u043D\u0435 \u0434\u043E\u0431\u0438\u0432\u0430\u0435\u0442
        \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430, \u0418\u043B\u0430\u0439
        \u0442\u0435\u0440\u044F\u0435\u0442 5% \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F."
      objectReference: {fileID: 0}
