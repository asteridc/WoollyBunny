--- !u!114 &2133042856
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2133042849}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: da5180d0433b1604683a6f5791502818, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PumpkinLanternAnimator
  openButton: {fileID: 2133042855}
  closeButton: {fileID: 0}
  panelCanvasGroup: {fileID: 477526628}
  panelTransform: {fileID: 477526626}
  animationDuration: 0.35
  hiddenScale: 0.94
  sidneyPhraseText: {fileID: 197065444}
  sidneyPhrases:
  - "\u041F\u043E\u0433\u043E\u0434\u0438\u2026 \u0410 \u043D\u0435 \u0442\u0435\u0431\u044F
    \u043B\u0438 \u044F \u0432\u0438\u0434\u0435\u043B\u0430 \u0437\u0434\u0435\u0441\u044C
    \u043F\u044F\u0442\u044C \u043C\u0438\u043D\u0443\u0442 \u043D\u0430\u0437\u0430\u0434?"
  - "\u041C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0434\u043E\u043C
    \u0445\u043E\u0447\u0435\u0442 \u043D\u0430\u043C \u0447\u0442\u043E-\u0442\u043E
    \u0441\u043A\u0430\u0437\u0430\u0442\u044C... \u0418\u0434\u0438 \u043F\u0435\u0440\u0432\u044B\u043C,
    \u0430 \u0442\u043E \u0424\u0440\u0435\u0434 \u0441\u0441\u044B\u043A\u0443\u0435\u0442."
  - "\u042F \u0431\u044B \u0441\u043A\u0430\u0437\u0430\u043B\u0430, \u0447\u0442\u043E
    \u0432\u0438\u0434\u0435\u043B\u0430 \u0432\u0435\u0449\u0438 \u0438 \u043F\u043E\u0441\u0442\u0440\u0430\u0448\u043D\u0435\u0435.
    \u041D\u043E \u044F \u043D\u0435 \u0445\u043E\u0447\u0443 \u0432\u0440\u0430\u0442\u044C
    \u0442\u0435\u0431\u0435 \u0432 \u043B\u0438\u0446\u043E."
  - "\u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u0442\u0440\u0430\u0442\u044C
    \u0432\u0441\u0435 \u0441\u0440\u0430\u0437\u0443. \u0425\u043E\u0442\u044F \u043A\u0442\u043E
    \u044F \u0442\u0430\u043A\u0430\u044F, \u0447\u0442\u043E\u0431\u044B \u043C\u0435\u0448\u0430\u0442\u044C
    \u0442\u0435\u0431\u0435 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u044C
    \u0444\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u044B\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u044F
    \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u0441\u043B\u0430\u0434\u043A\u043E\u0433\u043E
    \u043A\u0440\u0438\u0437\u0438\u0441\u0430?"
  - "\u0415\u0441\u043B\u0438 \u043D\u0430\u0433\u0440\u0430\u0434\u0430 \u043E\u043A\u0430\u0436\u0435\u0442\u0441\u044F
    \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u043E\u0439, \u0442\u044B \u0445\u043E\u0442\u044F
    \u0431\u044B \u0441\u043C\u043E\u0436\u0435\u0448\u044C \u0441\u043A\u0430\u0437\u0430\u0442\u044C,
    \u0447\u0442\u043E \u0434\u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u043E\u043D\u0430
    \u0442\u0435\u0431\u0435 \u0437\u0430 \u043A\u043E\u043D\u0444\u0435\u0442\u044B."
  - "\u0417\u043D\u0430\u0435\u0448\u044C, \u0438\u043D\u043E\u0433\u0434\u0430 \u043C\u043D\u0435
    \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0447\u0442\u043E \u044F \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436
    \u043A\u0430\u043A\u043E\u0439-\u0442\u043E \u043E\u0447\u0435\u043D\u044C \u0441\u0442\u0440\u0430\u043D\u043D\u043E\u0439
    \u0438\u0441\u0442\u043E\u0440\u0438\u0438. \u041D\u043E \u044D\u0442\u043E,
    \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u0433\u043B\u0443\u043F\u043E\u0441\u0442\u0438."
  - "\u0422\u044B \u0441\u043B\u044B\u0448\u0430\u043B \u043E \u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u0438
    \u0425? \u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u043D\u0430\u0441 \u043A
    \u0447\u0435\u043C\u0443-\u0442\u043E \u0433\u043E\u0442\u043E\u0432\u044F\u0442...
    \u0414\u0430 \u043B\u0430\u0434\u043D\u043E, \u043D\u0435 \u043F\u0430\u0440\u044C\u0441\u044F,
    \u044F \u0448\u0443\u0447\u0443. "
  - "\u042F \u0443\u0436\u0435 30 \u043B\u0435\u0442 \u0443\u0431\u0438\u0432\u0430\u044E
    \u0433\u043E\u0443\u0441\u0442\u0444\u0435\u0439\u0441\u0430. \u0422\u044B \u0434\u0443\u043C\u0430\u0435\u0448\u044C
    \u043F\u043E\u0441\u043B\u0435 \u044D\u0442\u043E\u0433\u043E \u044F \u0447\u0435\u0433\u043E-\u0442\u043E
    \u0431\u043E\u044E\u0441\u044C?"
  - "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0440\u0430\u0437 \u043C\u043D\u0435 \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F
    \u043F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u044C \u044D\u0442\u0443 \u0444\u0440\u0430\u0437\u0443,
    \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u0442\u044B \u0437\u0430\u043C\u0435\u0442\u0438\u0448\u044C,
    \u0447\u0442\u043E \u044F \u0435\u0435 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u044E?"
  - "\u041A\u043E\u043D\u0444\u0435\u0442\u044B\u043A\u0432\u044B, \u043F\u0440\u0438\u0437\u044B,
    \u0437\u0430\u0433\u0430\u0434\u043E\u0447\u043D\u044B\u0435 \u043A\u043E\u0434\u044B\u2026
    \u0417\u0432\u0443\u0447\u0438\u0442 \u043A\u0430\u043A \u0431\u0435\u0437\u043E\u0431\u0438\u0434\u043D\u0430\u044F
    \u0430\u043A\u0446\u0438\u044F. \u0418\u043C\u0435\u043D\u043D\u043E \u0442\u0430\u043A
    \u043E\u0431\u044B\u0447\u043D\u043E \u0438 \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442\u0441\u044F
    \u0441\u0430\u043C\u044B\u0435 \u0434\u043E\u0440\u043E\u0433\u0438\u0435 \u043E\u0448\u0438\u0431\u043A\u0438."
  - "\u0422\u044B \u0437\u043D\u0430\u0435\u0448\u044C, \u043A\u0430\u043A \u0437\u043E\u0432\u0443\u0442
    \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\u0430 \u044D\u0442\u043E\u0439
    \u0438\u0433\u0440\u044B? \u0410 \u043D\u043E\u043C\u0435\u0440 \u0435\u0433\u043E
    \u0435\u0441\u0442\u044C? \u041F\u0440\u043E\u0441\u0442\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0443\u044E\u0441\u044C..."
  - "\u0414\u0430 \u0442\u044B \u043A\u043E\u043D\u0444\u0435\u0442\u043D\u044B\u0439
    \u0431\u0438\u0437\u043D\u0435\u0441\u043C\u0435\u043D."
  - "\u041F\u0440\u0435\u043A\u0440\u0430\u0449\u0430\u0439 \u0438\u0433\u0440\u0430\u0442\u044C
    \u0432 \u043A\u043E\u043D\u0444\u0435\u0442\u043D\u0443\u044E \u043C\u043E\u043D\u043E\u043F\u043E\u043B\u0438\u044E!
    \u041F\u043E\u0439\u0434\u0435\u043C \u043D\u0430\u043F\u043E\u043B\u043D\u044F\u0442\u044C
    \u043D\u0430\u0448\u0438 \u043A\u043E\u0440\u0437\u0438\u043D\u044B \u0438 \u0440\u0430\u0437\u0432\u0435\u0435\u0432\u0430\u0442\u044C
    \u043C\u0438\u0444\u044B \u043E \u0434\u043E\u043C\u0435 \u211617!"
  - "\u0410 \u0442\u0435\u0431\u0435 \u0431\u044B\u043B\u043E \u0431\u044B \u043F\u0440\u0438\u044F\u0442\u043D\u043E
    \u0441\u0442\u043E\u044F\u0442\u044C \u0442\u0443\u0442 \u0431\u0435\u0437 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438
    \u043F\u043E\u0448\u0435\u0432\u0435\u043B\u0438\u0442\u044C\u0441\u044F?"
  - "\u0417\u0430\u043A\u0440\u044B\u0432\u0430\u0439 \u044D\u0442\u043E \u043E\u043A\u043D\u043E,
    \u0432\u0441\u0435\u0433\u043E \u0440\u0430\u0432\u043D\u043E \u043D\u0430 \u043C\u0435\u043B\u0438."
  - "\u041D\u0443-\u0443.. \u0427\u0442\u043E \u0436.. \u0421\u043D\u043E\u0432\u0430
    \u0442\u044B \u0438 \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u044B. "
  - "\u0421\u043B\u044B\u0445\u0430\u043B \u043E \u0441\u0442\u043E\u043A\u0433\u043E\u043B\u044C\u043C\u0441\u043A\u043E\u043C
    \u0441\u0438\u043D\u0434\u0440\u043E\u043C\u0435? \u041A\u0430\u0436\u0435\u0442\u0441\u044F,
    \u044F \u043F\u043E \u0443\u0448\u0438 \u0432 \u0442\u0435\u0431\u044F \u0432\u0442\u044E\u0440\u0438\u043B\u0430\u0441\u044C."
