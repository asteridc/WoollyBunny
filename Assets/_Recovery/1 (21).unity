    - target: {fileID: 6088962223778704926, guid: dc84b53fcf6897e4e9325e5f5dc41cd9, type: 3}
      propertyPath: englishText
      value: A shot that deals lethal damage restores 10% of Eli's maximum health.
        If the shot fails to kill the enemy, Eli loses 5% health.
      objectReference: {fileID: 0}
