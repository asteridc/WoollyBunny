    - target: {fileID: 7027160818463261096, guid: 484fe69d4c5ed204fb45f5fa39410786, type: 3}
      propertyPath: russianText
      value: "\u0420\u0435\u043B\u0438\u043A\u0442\u043E\u0432\u044B\u0439 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\n\n"
