    - target: {fileID: 7223590582996422636, guid: 484fe69d4c5ed204fb45f5fa39410786, type: 3}
      propertyPath: m_text
      value: "\u041E\u0441\u043A\u043E\u043B\u043E\u043A \u043C\u0435\u0442\u0430\u043B\u043B\u0430,
        \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0448\u0435\u0433\u043E \u0434\u043E\u043B\u0433\u0438\u0435
        \u0433\u043E\u0434\u044B \u043F\u043E\u0441\u043B\u0435 \u0422\u0435\u043C\u043D\u043E\u0433\u043E
        \u0414\u043D\u044F. \u0415\u0433\u043E \u0441\u043E\u0441\u0442\u0430\u0432
        \u0438 \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C \u0434\u043E
        \u0441\u0438\u0445 \u043F\u043E\u0440 \u0443\u0434\u0438\u0432\u043B\u044F\u044E\u0442
        \u043E\u0440\u0443\u0436\u0435\u0439\u043D\u0438\u043A\u043E\u0432."
      objectReference: {fileID: 0}
