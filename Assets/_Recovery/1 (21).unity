    - target: {fileID: 1255120884401598652, guid: dc84b53fcf6897e4e9325e5f5dc41cd9, type: 3}
      propertyPath: russianText
      value: "\u041A\u0430\u0436\u0434\u044B\u0439 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A,
        \u043F\u043E\u0431\u0435\u0436\u0434\u0435\u043D\u043D\u044B\u0439 \u041F\u0440\u0435\u0434\u043D\u0430\u0447\u0435\u0440\u0442\u0430\u043D\u0438\u0435\u043C,
