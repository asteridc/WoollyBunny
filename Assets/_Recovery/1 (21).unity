  tooltip: {fileID: 1540804555}
  canOpenWeaponOverview: 0
  canOpenMeleeOverview: 0
  weaponOverview: {fileID: 0}
  overviewData:
    weaponNameRu: "\u0417\u043E\u043B\u043E\u0442\u043E\u0439 \u0441\u0442\u0438\u0440\u0430\u0442\u0435\u043B\u044C"
    weaponNameEn: The Golden Eraser
    icon: {fileID: 21300000, guid: f041661a21d10f34e9d0d12728afd425, type: 3}
    typeRu: "\u041F\u0438\u0441\u0442\u043E\u043B\u0435\u0442"
    typeEn: Pistol
    rarityRu: "\u0420\u0435\u043B\u0438\u043A\u0442\u043E\u0432\u044B\u0439"
    rarityEn: Relic
    rarityColor: {r: 0.9333334, g: 0.97647065, b: 0.003921569, a: 1}
    damage: 55
    headMultiplier: 1.8
    torsoMultiplier: 1.05
    armsMultiplier: 0.96
    legsMultiplier: 0.9
    moduleCount: 3
    descriptionRu: "\u0423\u0431\u0438\u0439\u0446\u0430 \u0441 50 \u043A\u0430\u043B\u0438\u0431\u0440\u043E\u043C,
      \u043F\u0440\u043E\u0437\u0432\u0430\u043D\u043D\u044B\u0439 \"\u041F\u0443\u0441\u0442\u044B\u043D\u043D\u044B\u043C
      \u041E\u0440\u043B\u043E\u043C\", \u043F\u043E\u043A\u0440\u044B\u0442\u044B\u0439
      \u0447\u0438\u0441\u0442\u044B\u043C \u0437\u043E\u043B\u043E\u0442\u043E\u043C,
      \u043D\u0430\u043D\u043E\u0441\u0438\u0442 \u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u0443\u0440\u043E\u043D \u0441\u0435\u0440\u044C\u0435\u0437\u043D\u044B\u043C
      \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430\u043C, \u043D\u043E
      \u0432\u0441\u0435 \u0435\u0449\u0435 \u0441\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0442
      \u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430..."
    descriptionEn: "A .50-caliber killer known as the \"Desert Eagle,\" plated in
      pure gold, deals massive damage to formidable foes \u2014 but it still doesn't
      always get the job done..."
