  - text: "She died too - before I ever left the bunker. Old age\u2026 or her heart."
    speakerName: Eli
    characterName: "\u0418\u043B\u0430\u0439"
    isRadio: 0
    changeSpeakerName: 0
    changeCharacterSprite: 0
    changeBackground: 0
    characterSprite: {fileID: 0}
