  - text: "\u201C\u2026Damn.\u201D"
    speakerName: Eli
    characterName: "\u0418\u043B\u0430\u0439"
    isRadio: 0
    changeSpeakerName: 0
    changeCharacterSprite: 0
    changeBackground: 0
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: 9444dc73ca7df3543a6aa9b3fe83968a, type: 3}
    backgroundId: 0
    isOnRight: 0
    flipSpeakerImage: 0
    listenerCharacterName: 
    isListenerOnRight: 0
    flipListenerImage: 0
    showCollectibleView: 1
    collectibleTitle: "Goodbye, my daughter\u2026"
    collectibleContent: "I\u2019m sorry I couldn\u2019t wait any longer. A man can
      only endure so much. There is only one thing left - to try and reach those
      who still believe in something in this broken world.\n\r\nDo you remember where
      we hid the food?\r\nThe box with the numbers. January 18. The day you said
      \u201CDad\u201D for the first time. That\u2019s the code.\n\r\nIf you find
      this, take the map.\r\nIt might lead you to them.\r\nOr at least somewhere
      quieter.\n\r\nI\u2019m tired.\r\nForgive me.\r"
    collectibleIcon: {fileID: 21300000, guid: a42c8ec0ff27c024fab127cffe55cef1, type: 3}
    showItemNotification: 1
    itemName: "Goodbye, my daughter\u2026"
    itemType: Collectible Item
    itemRarity: 3
    itemIcon: {fileID: 21300000, guid: a42c8ec0ff27c024fab127cffe55cef1, type: 3}
    showStoryNotification: 0
