    - path: 1
      overrideText: "\u041B\u0443\u043D\u0430 \u0432\u0438\u0441\u0435\u043B\u0430,
        \u043A\u0430\u043A \u0433\u043B\u0430\u0437 \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u0430,
        \u0441\u043B\u0435\u0434\u044F \u0437\u0430 \u0418\u043B\u0430\u0435\u043C."
      showStoryNotification: 0
      storyNotificationText: "\u041F\u0443\u0442\u044C \u041A\u0440\u043E\u0432\u043E\u0436\u0430\u0434\u043D\u043E\u0441\u0442\u0438"
