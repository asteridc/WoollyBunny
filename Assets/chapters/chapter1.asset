    - path: 2
      overrideText: "\u0414\u043B\u044F \u043A\u043E\u0433\u043E-\u0442\u043E \u2013
        \u043F\u0443\u0442\u0435\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C,
        \u0434\u043B\u044F \u0418\u043B\u0430\u044F - \u043C\u043E\u043B\u0447\u0430\u043B\u0438\u0432\u044B\u0439
        \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C."
