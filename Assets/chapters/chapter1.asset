    - path: 1
      overrideText: "\u0415\u0441\u043B\u0438 \u044F \u0434\u043E\u0439\u0434\u0443
        \u0434\u043E \u043A\u043E\u043D\u0446\u0430\u2026 \u0422\u044B \u0431\u0443\u0434\u0435\u0448\u044C
        \u0437\u043D\u0430\u0442\u044C. \u0422\u044B \u0443\u0432\u0438\u0434\u0438\u0448\u044C
        \u044D\u0442\u043E. \u041E\u0431\u0435\u0449\u0430\u044E."
