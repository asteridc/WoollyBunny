  - text: "\u041A\u0435\u0440\u0435\u043C \u0441\u043B\u0435\u0433\u043A\u0430 \u043F\u0440\u0438\u0449\u0443\u0440\u0438\u043B\u0441\u044F,
      \u0441\u0436\u0430\u043B \u0433\u0443\u0431\u044B, \u0441\u043B\u043E\u0432\u043D\u043E
      \u0445\u043E\u0442\u0435\u043B \u0447\u0442\u043E-\u0442\u043E \u0441\u043A\u0430\u0437\u0430\u0442\u044C\u2026
      \u043D\u043E \u043F\u043E\u0434\u0430\u0432\u0438\u043B \u044D\u0442\u043E
      \u0436\u0435\u043B\u0430\u043D\u0438\u0435. \u041E\u043D \u0431\u0440\u043E\u0441\u0438\u043B
      \u0432\u0437\u0433\u043B\u044F\u0434 \u0447\u0435\u0440\u0435\u0437 \u043F\u043B\u0435\u0447\u043E,
      \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u044F, \u043D\u0435 \u043F\u043E\u0434\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u044E\u0442
      \u043B\u0438 \u041C\u0438\u0440\u043E\u0442\u0432\u043E\u0440\u0446\u044B."
