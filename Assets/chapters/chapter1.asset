  - text: "\u0421\u043E\u043B\u043D\u0446\u0435 \u0438\u0441\u0447\u0435\u0437\u043B\u043E
      \u0437\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u043E\u043C.
      \u041A\u0440\u0430\u0441\u043D\u044B\u0439 \u043E\u0442\u0431\u043B\u0435\u0441\u043A
      \u0432 \u043E\u0431\u043B\u0430\u043A\u0430\u0445 \u0443\u0433\u0430\u0441\u0430\u043B,
      \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044F \u043D\u0435\u0431\u043E \u0432
      \u0442\u0435\u043C\u043D\u043E-\u0441\u0438\u043D\u0438\u0445 \u0442\u043E\u043D\u0430\u0445.
      \u041B\u0443\u043D\u0430 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u043B\u0430\u0441\u044C
      - \u0442\u0438\u0445\u0430\u044F, \u0445\u043E\u043B\u043E\u0434\u043D\u0430\u044F,
      \u0447\u0443\u0436\u0430\u044F."
