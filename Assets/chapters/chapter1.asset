  - text: "\u0412\u043E\u0442 \u0447\u0442\u043E, \u0443\u043C\u043D\u0438\u043A\u0438.
      \u0423 \u043D\u0430\u0441 \u0442\u0443\u0442 \u043D\u0435 \u043A\u0443\u0440\u043E\u0440\u0442.
      \u041F\u0440\u043E\u043F\u0443\u0441\u043A\u043E\u0432 \u043D\u0435\u0442,
      \u0435\u0434\u044B \u043D\u0435\u0442, \u043D\u0438\u0449\u0438\u0445 \u043D\u0435
      \u043F\u0443\u0441\u043A\u0430\u0435\u043C, \u0441\u043E\u043F\u043B\u0438\u0432\u044B\u0445
      \u0442\u043E\u0436\u0435. \u0410 \u0443 \u0432\u0430\u0441 \u043D\u0438 \u043A\u043B\u0435\u0439\u043C\u0430,
      \u043D\u0438 \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430, \u043D\u0438
      \u0441\u0432\u044F\u0437\u0435\u0439."
