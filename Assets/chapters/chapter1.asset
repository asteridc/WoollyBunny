  - text: "\u041F\u043E\u0434 \u0441\u0442\u0430\u0440\u044B\u043C \u0434\u0443\u0431\u043E\u043C,
      \u0447\u0442\u043E \u0440\u043E\u0441 \u043D\u0435\u0434\u0430\u043B\u0435\u043A\u043E
      \u043E\u0442 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0433\u043E \u0446\u0435\u043D\u0442\u0440\u0430,
      \u043E\u043D\u0438 \u0432\u044B\u0440\u044B\u043B\u0438 \u043C\u043E\u0433\u0438\u043B\u0443.
      \u0417\u0435\u043C\u043B\u044F \u0431\u044B\u043B\u0430 \u043C\u043E\u043A\u0440\u043E\u0439
      \u0438 \u0442\u044F\u0436\u0435\u043B\u043E\u0439, \u0441\u043B\u043E\u0432\u043D\u043E
      \u0433\u043E\u0442\u043E\u0432\u0438\u043B\u0430\u0441\u044C \u0445\u043E\u0440\u043E\u043D\u0438\u0442\u044C
      \u0430\u043D\u0433\u0435\u043B\u0430."
