  - text: "\u0418\u043B\u0430\u0439 \u0448\u0430\u0433\u043D\u0443\u043B \u043F\u0435\u0440\u0432\u044B\u043C,
      \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F\u0441\u044C: \u043D\u0435
      \u0438\u0437-\u0437\u0430 \u0441\u0442\u0440\u0430\u0445\u0430, \u0430 \u0447\u0442\u043E\u0431\u044B
      \u043E\u0446\u0435\u043D\u0438\u0442\u044C \u043E\u0431\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443.
      \u041E\u043D \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B:
      \u044D\u0442\u043E \u0437\u0430\u0434\u0430\u043D\u0438\u0435 - \u043F\u0435\u0440\u0432\u044B\u0439
      \u0448\u0430\u0433 \u0432 \u043D\u043E\u0432\u044B\u0439 \u043C\u0438\u0440.
      \u0418\u043B\u0438 \u0432 \u0435\u0433\u043E \u043E\u0431\u0440\u0430\u0442\u043D\u0443\u044E
      \u0441\u0442\u043E\u0440\u043E\u043D\u0443."
