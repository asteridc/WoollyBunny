  - text: "\u0421\u043F\u0440\u0430\u0432\u0430, \u0437\u0430 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043E\u043C
      \u0443\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u043D\u043E\u0433\u043E \u0437\u0430\u0431\u043E\u0440\u0430,
      \u0432\u0438\u0434\u043D\u0435\u043B\u0430\u0441\u044C \u0441\u0442\u0430\u0440\u0430\u044F
      \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
      \u0431\u0443\u0434\u043A\u0430 - \u043E\u0431\u043B\u0435\u0437\u043B\u0430\u044F,
      \u0432\u0441\u044F \u0432 \u0441\u043B\u0435\u0434\u0430\u0445 \u0441\u0430\u0436\u0438
      \u0438 \u0437\u0430\u043F\u0435\u043A\u0448\u0435\u0433\u043E\u0441\u044F \u043C\u0430\u0441\u043B\u0430.
      \u041E\u0442 \u043D\u0435\u0435 \u0442\u044F\u043D\u0443\u043B\u0438\u0441\u044C
      \u043F\u0440\u043E\u0432\u043E\u0434\u0430 \u0432\u0433\u043B\u0443\u0431\u044C
      \u0431\u0435\u0442\u043E\u043D\u043D\u043E\u0433\u043E \u043F\u0435\u0440\u0438\u043C\u0435\u0442\u0440\u0430."
