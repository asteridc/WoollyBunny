  - text: "\u042F \u043F\u0440\u043E\u0441\u0442\u043E\u2026 \u044F \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u043C\u044F\u0433\u043A\u0438\u0439. \u0423\u0432\u0438\u0434\u0435\u043B
      \u0432 \u0432\u0430\u0441 \u0447\u0442\u043E-\u0442\u043E \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435.
      \u0425\u043E\u0442\u0435\u043B \u043F\u043E\u043C\u043E\u0447\u044C... \u0445\u043E\u0442\u044F
