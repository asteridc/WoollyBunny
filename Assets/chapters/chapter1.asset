  - text: "\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u043F\u043E\u043B\u043D\u044B\u0439
      \u043A\u0440\u0430\u0445 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u0430
      - \u043D\u0435 \u0438\u0437\u2011\u0437\u0430 \u0432\u043E\u0439\u043D\u044B
      \u0438 \u043D\u0435 \u0438\u0437\u2011\u0437\u0430 \u0431\u043E\u043B\u0435\u0437\u043D\u0438,
      \u0430 \u0438\u0437\u2011\u0437\u0430 \u043B\u043E\u043C\u043A\u0438."
