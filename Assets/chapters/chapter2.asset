  - text: "\u0414\u0435\u0440\u0436\u0438, \xAB\u0421\u0442\u0438\u0440\u0430\u0442\u0435\u043B\u044C\xBB.
      \u0414\u0430\u043B\u044C\u043D\u043E\u0431\u043E\u0439\u043D\u044B\u0439 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442,
      \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u0430\u044F \u043E\u0442\u0434\u0430\u0447\u0430.
      \u0415\u0441\u043B\u0438 \u0442\u044B \u043C\u0435\u0442\u043A\u0438\u0439,
      \u0442\u043E \u043F\u0440\u043E\u0431\u043B\u0435\u043C \u043D\u0435 \u0431\u0443\u0434\u0435\u0442
      \u0441 \u044D\u0442\u043E\u0439 \u0441\u0442\u0430\u0440\u0443\u0448\u043A\u043E\u0439."
