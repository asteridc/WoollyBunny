  - text: " \u041D\u0443 \u0447\u0442\u043E, \u0434\u0430\u0432\u0430\u0439, \u043E\u0442\u0432\u0435\u0434\u0443
      \u0442\u0435\u0431\u044F \u043A \u0420\u0438\u043D\u0435. \u0422\u043E\u043B\u044C\u043A\u043E
      \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u0435\u0435 \u0441 \u041C\u0430\u0439\u043A\u043E\u043C,
      \u043E\u043D \u043D\u0435 \u043E\u0441\u043E\u0431\u043E \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0447\u0438\u0432\u044B\u0439
