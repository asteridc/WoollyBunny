  - text: "\u0418\u043C\u0435\u043D\u043D\u043E. \u0418\u043C \u0434\u043E \u043B\u0430\u043C\u043F\u043E\u0447\u043A\u0438
      \u043D\u0430 \u0441\u043B\u0430\u0431\u044B\u0435 \u043B\u0443\u0447\u0438
      \u0441\u0432\u0435\u0442\u0430. \u0412 \u0442\u0430\u043A\u0438\u0445 \u0441\u043B\u0443\u0447\u0430\u044F\u0445
      \u043F\u043E\u043C\u043E\u0436\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
