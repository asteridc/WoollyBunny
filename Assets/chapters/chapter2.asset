  - text: "\u041D\u0430 \u043F\u043E\u043B\u0443 \u0431\u044B\u043B\u0438 \u0441\u0432\u0435\u0436\u0438\u0435
      \u0441\u043B\u0435\u0434\u044B \u0433\u0440\u044F\u0437\u0438. \u0425\u0430\u043D\u043D\u0430
      \u043D\u0430\u043A\u043B\u043E\u043D\u0438\u043B\u0430\u0441\u044C, \u0434\u043E\u0442\u0440\u043E\u043D\u0443\u043B\u0430\u0441\u044C
      \u0434\u043E \u043E\u0442\u043F\u0435\u0447\u0430\u0442\u043A\u0430 \u2013
      \u043E\u043D \u0431\u044B\u043B \u0432\u043B\u0430\u0436\u043D\u044B\u043C.
      \u041A\u0442\u043E-\u0442\u043E \u043D\u0435\u0434\u0430\u0432\u043D\u043E
      \u0437\u0434\u0435\u0441\u044C \u0431\u044B\u043B."
