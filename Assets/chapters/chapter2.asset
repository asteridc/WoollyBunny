  - text: "\u0418\u0433\u0440\u0443\u0448\u043A\u0430 \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B\u0430
      \u0438\u0437\u043D\u043E\u0448\u0435\u043D\u043D\u043E\u0439: \u0442\u043A\u0430\u043D\u044C
      \u043F\u043E\u0442\u0443\u0441\u043A\u043D\u0435\u043B\u0430, \u0430 \u0433\u043B\u0430\u0437\u0430
      \u0431\u044B\u043B\u0438 \u043F\u0435\u0440\u0435\u0442\u044F\u043D\u0443\u0442\u044B
      \u0447\u0451\u0440\u043D\u044B\u043C\u0438 \u043D\u0438\u0442\u044F\u043C\u0438
      \u043A\u0440\u0435\u0441\u0442-\u043D\u0430\u043A\u0440\u0435\u0441\u0442,
      \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u043A\u0442\u043E-\u0442\u043E
      \u043D\u0430\u043C\u0435\u0440\u0435\u043D\u043D\u043E \u0437\u0430\u043A\u0440\u044B\u043B
      \u0438\u0445."
