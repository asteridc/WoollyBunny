    - path: 2
      overrideText: "\u041F\u043E\u0434\u043E\u0437\u0440\u0435\u043D\u0438\u044F
        \u0418\u043B\u0430\u044F \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u043B\u0438\u0441\u044C.
        \u0411\u0430\u0440\u0441 \u043C\u043E\u0433 \u0431\u044B\u0442\u044C \u043D\u0435
        \u0442\u0435\u043C, \u043A\u0435\u043C \u0441\u0435\u0431\u044F \u043F\u044B\u0442\u0430\u043B\u0441\u044F
