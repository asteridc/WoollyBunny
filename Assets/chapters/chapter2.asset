  - text: "\u0410 \u043A\u0430\u043A \u0436\u0435! \u041F\u043E\u043C\u0435\u0440\u043B\u0438
      \u0431\u044B \u0441\u043E \u0441\u043A\u0443\u043A\u0438 \u0432\u0441\u0435!
      \u0422\u044B \u0431\u044B \u0432\u0438\u0434\u0435\u043B, \u043A\u0430\u043A
      \u044D\u0442\u0438 \u043E\u0431\u0430 \u043A\u0440\u0430\u0441\u043D\u0435\u044E\u0442,
