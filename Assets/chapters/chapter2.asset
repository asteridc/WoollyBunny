  - text: "\u041F\u043E\u043A\u0430 \u0418\u043B\u0430\u0439 \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u043B
      \u0448\u043A\u0430\u0444\u0447\u0438\u043A\u0438, \u0425\u0430\u043D\u043D\u0430
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0430\u0441\u044C \u0443
      \u0441\u0442\u043E\u043B\u0430. \u0415\u0435 \u0432\u0437\u0433\u043B\u044F\u0434
      \u0437\u0430\u0446\u0435\u043F\u0438\u043B\u0441\u044F \u0437\u0430 \u0443\u0433\u043E\u043B\u043E\u043A
      \u0447\u0435\u0433\u043E-\u0442\u043E, \u0432\u044B\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044E\u0449\u0435\u0433\u043E
      \u0438\u0437-\u043F\u043E\u0434 \u0441\u0432\u0430\u043B\u0435\u043D\u043D\u044B\u0445
      \u043A\u043E\u0440\u043E\u0431\u043E\u043A."
