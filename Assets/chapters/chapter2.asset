  - text: "\u0421\u0442\u0430\u0440\u044B\u0439 \u043A\u0443\u043B\u0435\u0440 \u0441\u0442\u043E\u044F\u043B
      \u0432 \u0443\u0433\u043B\u0443, \u043E\u0442\u0440\u0430\u0436\u0430\u044F
      \u043C\u0443\u0442\u043D\u044B\u0439 \u0441\u0432\u0435\u0442 \u0438\u0437
      \u043E\u043A\u043D\u0430. \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0448\u043A\u0430\u0444\u0447\u0438\u043A\u043E\u0432 \u0431\u044B\u043B\u0438
