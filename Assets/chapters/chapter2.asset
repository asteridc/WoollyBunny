  - text: "\u0419\u043E\u0445\u0430\u043D \u043D\u0435 \u0434\u0443\u043C\u0430\u043B,
      \u0447\u0442\u043E \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u044C
      \u043E\u0442\u0440\u0430\u0441\u0442\u0438\u0442 \u043A\u043E\u0440\u043D\u0438
      \u0432 \u042D\u043B\u0438\u0437\u0438\u0443\u043C\u0435, \u043D\u043E \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C\u0441\u044F
      \u043E\u0442 \u044D\u0442\u043E\u0433\u043E \u0440\u0430\u0439\u043E\u043D\u0430
      \u043D\u0435 \u0441\u0442\u0430\u043B. \u0422\u0430\u043A \u0447\u0442\u043E,
      \u0435\u0441\u0442\u044C \u043F\u0440\u0430\u0432\u0438\u043B\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043D\u0430\u0434\u043E \u0441\u043E\u0431\u043B\u044E\u0434\u0430\u0442\u044C."
