  - text: "\u0422\u0435\u043F\u0435\u0440\u044C, \u043A\u043E\u0433\u0434\u0430 \u0418\u043B\u0430\u0439
      \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u0441 \u0441\u0430\u043C\u0438\u043C
      \u0441\u043E\u0431\u043E\u0439 \u043E\u0434\u0438\u043D \u043D\u0430 \u043E\u0434\u0438\u043D,
      \u043D\u0443\u0436\u043D\u043E \u0431\u044B\u043B\u043E \u0447\u0435\u043C-\u0442\u043E
