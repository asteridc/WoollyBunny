  - text: "\u0420\u044B\u0446\u0430\u0440\u0438 \u0438 \u0434\u0435\u0432\u044B,
      \u0447\u0442\u043E \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u043B\u0438 \u0437\u0430
      \u043A\u0430\u0437\u043D\u044C\u044E \u0433\u0435\u0440\u043E\u044F, \u0440\u0430\u0434\u043E\u0432\u0430\u043B\u0438\u0441\u044C.
      \u0427\u0443\u0436\u0430\u043A \u043F\u043E\u0433\u0438\u0431\u0430\u0435\u0442
      \u043F\u0440\u044F\u043C\u043E \u043D\u0430 \u0438\u0445 \u0433\u043B\u0430\u0437\u0430\u0445.
      \u0410 \u043C\u043E\u0436\u0435\u0442, \u0434\u0430\u0436\u0435 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u044B\u0439
