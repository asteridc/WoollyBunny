  - text: "\u0414\u0435\u043B\u043E \u0432 \u0441\u0430\u043C\u043E\u043E\u0431\u043B\u0430\u0434\u0430\u043D\u0438\u0438.
      \u0411\u043E\u0440\u044F\u0441\u044C \u0441 \u0436\u0435\u043B\u0430\u043D\u0438\u0435\u043C,
      \u043E\u043D\u0438 \u0432\u044B\u0436\u0438\u0432\u0430\u044E\u0442 \u0438
      \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F \u043B\u044E\u0434\u044C\u043C\u0438."
