      \u0433\u043E\u0440\u043E\u0434\u0430 \u0438 \u043F\u043E\u043F\u0430\u0441\u0442\u044C
      \u0432 \u0446\u0435\u043D\u0442\u0440, \u043D\u0443\u0436\u043D\u043E \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u044C,
      \u0447\u0442\u043E \u0432 \u0442\u0435\u0431\u0435 \u0435\u0441\u0442\u044C
      \u0445\u0440\u0430\u0431\u0440\u043E\u0441\u0442\u044C \u0438 \u0434\u043E\u0431\u043B\u0435\u0441\u0442\u044C."
