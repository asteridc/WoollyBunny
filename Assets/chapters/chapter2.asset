  - text: "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0431\u044B\u043B \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u043C \u043D\u043E\u0441\u0438\u0442\u0435\u043B\u0435\u043C
      \u0441\u0432\u0435\u0442\u0430. \u0418\u0445 \u0437\u0430\u0440\u0430\u0436\u0451\u043D\u043D\u044B\u0439
      \u043C\u043E\u0437\u0433 \u043D\u0435 \u0440\u0430\u0437\u043B\u0438\u0447\u0430\u043B
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u0438 \u0442\u043E\u0433\u043E,
      \u043A\u0442\u043E \u0435\u0433\u043E \u0434\u0435\u0440\u0436\u0438\u0442.
      \u0418\u043C \u043D\u0443\u0436\u0435\u043D \u0431\u044B\u043B \u0441\u0430\u043C
      \u0441\u0442\u0438\u043C\u0443\u043B."
