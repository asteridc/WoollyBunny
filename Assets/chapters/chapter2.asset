  - text: "\u0420\u0430\u043D\u044C\u0448\u0435, \u043A\u0441\u0442\u0430\u0442\u0438,
      \u0435\u0435 \u043C\u0430\u0442\u044C \u0438 \u043F\u0440\u0430\u0432\u0438\u043B\u0430,
      \u043D\u043E \xAB\u043F\u0440\u0435\u0441\u0442\u043E\u043B\xBB \u0434\u043E\u0441\u0442\u0430\u043B\u0441\u044F
      \u0420\u0438\u043D\u0435, \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
