  - text: "\u0428\u0442\u043E\u0440\u044B \u0447\u0443\u0442\u044C \u043A\u043E\u043B\u044B\u0445\u0430\u043B\u0438\u0441\u044C,
      \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u044F \u043F\u043E\u043B\u043E\u0441\u044B
      \u0442\u0443\u0441\u043A\u043B\u043E\u0433\u043E \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u043E\u0433\u043E
      \u0441\u0432\u0435\u0442\u0430, \u2014 \u0438 \u0432 \u044D\u0442\u0438\u0445
      \u043F\u043E\u043B\u043E\u0441\u0430\u0445 \u043F\u044B\u043B\u044C \u0434\u0432\u0438\u0433\u0430\u043B\u0430\u0441\u044C
      \u0442\u0430\u043A \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E, \u0441\u043B\u043E\u0432\u043D\u043E
