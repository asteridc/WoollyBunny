  - text: "\u042F \u043D\u0430 \u0432\u0440\u0435\u043C\u044F \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u043B
      \u041A\u0435\u0440\u0435\u043C\u0430 \u0441 \u0432\u0430\u0448\u0435\u0439
      \u043B\u0438\u043D\u0438\u0438 \u0438 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u043B\u0441\u044F.
      \u041A\u0430\u043A \u044F \u044D\u0442\u043E \u0441\u0434\u0435\u043B\u0430\u043B?
      \u041F\u0440\u043E\u0448\u043B\u043E \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u0441 \u043B\u0438\u0448\u043D\u0438\u043C \u043B\u0435\u0442, \u043D\u043E
      \u0445\u0430\u043A\u0435\u0440\u044B \u0432\u0441\u0435 \u0435\u0449\u0435
      \u0432 \u043C\u043E\u0434\u0435."
