  - text: "\u0422\u0430\u043A \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u0433\u043B\u0430\u0432\u043D\u0443\u044E
      \u0432 \u0421\u0432\u044F\u0442\u043E\u0439 \u0441\u0432\u044F\u0442\u044B\u0445.
      \u0420\u0438\u043D\u0430, \u0432\u043B\u0430\u0441\u0442\u043D\u0430\u044F,
