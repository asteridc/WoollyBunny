  - text: "\u041F\u043E \u0441\u0442\u0435\u043D\u0430\u043C \u0442\u044F\u043D\u0443\u043B\u0438\u0441\u044C
      \u043F\u043E\u0442\u0443\u0441\u043A\u043D\u0435\u0432\u0448\u0438\u0435 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0438
      \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432, \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043B\u0438\u0446\u0430 \u0431\u044B\u043B\u0438 \u0432\u044B\u0440\u0435\u0437\u0430\u043D\u044B
      \u043D\u043E\u0436\u043E\u043C. \u041D\u0430 \u0441\u0442\u043E\u043B\u0435
      \u2013 \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u0444\u0435,
      \u0437\u0430\u043F\u0435\u043A\u0448\u0430\u044F\u0441\u044F \u0442\u0435\u043C\u043D\u0430\u044F
      \u043B\u0443\u0436\u0430, \u0437\u0430\u0441\u0442\u044B\u0432\u0448\u0430\u044F
      \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430."
