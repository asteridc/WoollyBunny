  - text: "\u041F\u043E \u0438\u0434\u0435\u0435, \u044D\u0442\u043E \u0441\u043E\u043B\u043D\u0446\u0435,
      \u043D\u043E \u0432\u0433\u043B\u0443\u0431\u0438 \u042D\u043B\u0438\u0437\u0438\u0443\u043C\u0430
      \u043E\u0447\u0435\u043D\u044C \u043C\u043D\u043E\u0433\u043E \u0437\u0430\u0431\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u0445
      \u043D\u0435\u0431\u043E\u0441\u043A\u0440\u0435\u0431\u043E\u0432 \u0438 \u0432\u044B\u0448\u0435\u043A,
      \u0438\u0437-\u0437\u0430 \u0447\u0435\u0433\u043E \u043B\u0443\u0447\u0438
      \u043F\u043E\u0447\u0442\u0438 \u043D\u0435 \u0434\u043E\u0445\u043E\u0434\u044F\u0442
      \u0434\u043E \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438."
