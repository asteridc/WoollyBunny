  - text: "\u041E\u043D \u0441\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E\u0431\u044B
      \u0418\u043B\u0430\u0439 \xAB\u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043B
      \u0441\u0441\u044B\u043A\u0443\u043D\u0430 \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0435\xBB.
      \u0412 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u043E\u0432\u043E\u043C \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435,
      \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u043E\u043D\u0438 \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0438\u0441\u044C,
      \u0431\u044B\u043B\u0438 \u0432\u0441\u0435\u0433\u043E \u0434\u0432\u0435
      \u0434\u0432\u0435\u0440\u0438, \u0432\u0435\u0434\u0443\u0449\u0438\u0435
      \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u044B, - \u043A\u043B\u0430\u0434\u043E\u0432\u043A\u0430
      \u0438 \u043A\u043E\u043C\u043D\u0430\u0442\u0430 \u0434\u043B\u044F \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u0430."
