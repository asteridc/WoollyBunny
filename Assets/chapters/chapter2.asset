  - text: "\u0412\u0440\u0435\u043C\u044F \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0435
      \u0441\u043B\u043E\u0432\u043D\u043E \u0437\u0430\u0441\u0442\u044B\u043B\u043E.
      \u0412\u043E\u0437\u0434\u0443\u0445 \u0431\u044B\u043B \u0433\u0443\u0441\u0442\u044B\u043C,
      \u043F\u0440\u043E\u043F\u0438\u0442\u0430\u043D\u043D\u044B\u043C \u043F\u043B\u0435\u0441\u0435\u043D\u044C\u044E
      \u0438 \u0447\u0435\u043C-\u0442\u043E \u0441\u0442\u0430\u0440\u044B\u043C,
      \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0449\u0438\u043C \u0433\u043D\u0438\u044E\u0449\u0435\u0435
      \u0436\u0435\u043B\u0435\u0437\u043E."
