  - text: "\u041D\u0435\u0442, \u0425\u0430\u043D\u043D\u0430. \u0420\u0430\u0432\u043D\u043E\u0441\u0442\u044C
      \u043C\u0435\u0436\u0434\u0443 \u0431\u043B\u0438\u0436\u043D\u0438\u043C\u0438
      \u0445\u043E\u0442\u044C \u0438 \u043C\u0435\u0447\u0442\u0430 \u043C\u043D\u043E\u0433\u0438\u0445
      \u0431\u0435\u0434\u043D\u044B\u0445, \u043D\u043E \u043D\u0435 \u043C\u0435\u0447\u0442\u0430
      \u0431\u043E\u0433\u0430\u0442\u044B\u0445. \u0418\u043D\u044B\u043C\u0438
      \u0441\u043B\u043E\u0432\u0430\u043C\u0438, \u043E\u043D\u0430 \u043D\u0435\u0434\u043E\u0441\u0442\u0438\u0436\u0438\u043C\u0430."
