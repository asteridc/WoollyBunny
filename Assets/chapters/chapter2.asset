  - text: "\u041D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u043F\u043E\u043A\u0438\u0434\u0430\u0439
      \u0441\u0432\u0435\u0442, \u043D\u0435 \u043E\u0442\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0439\u0441\u044F
      \u043E\u0442 \u043D\u0435\u0433\u043E, \u043D\u0435 \u0437\u0430\u0445\u043E\u0434\u0438
      \u0432 \u0442\u0435\u043D\u044C. \u0421\u043B\u044B\u0448\u0438\u0448\u044C
      \u043C\u0435\u043D\u044F? \u041D\u0438\u043A\u043E\u0433\u0434\u0430! "
