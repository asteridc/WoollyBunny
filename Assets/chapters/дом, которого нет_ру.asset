  - text: "\xAB\u0414\u043E\u043C, \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
      \u043D\u0435\u0442\xBB \u043F\u043E\u0432\u0435\u0441\u0442\u0432\u0443\u0435\u0442
      \u043E \u0433\u0440\u0443\u043F\u043F\u0435 \u0434\u0440\u0443\u0437\u0435\u0439,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0432\u043C\u0435\u0441\u0442\u0435
      \u0432\u0435\u0441\u0435\u043B\u043E \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u043B\u0438
      \u043D\u043E\u0447\u044C \u0425\u0435\u043B\u043B\u043E\u0443\u0438\u043D\u0430.
      \u0423\u0441\u043B\u044B\u0448\u0430\u0432 \u043B\u0435\u0433\u0435\u043D\u0434\u0443
      \u043E \u0437\u0430\u0433\u0430\u0434\u043E\u0447\u043D\u043E\u043C \u0434\u043E\u043C\u0435
      \u211617, \u0442\u0435 \u0440\u0435\u0448\u0438\u043B\u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C,
      \u0447\u0442\u043E \u0436\u0435 \u0442\u0430\u043C \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E
      \u043D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435\u2026"
