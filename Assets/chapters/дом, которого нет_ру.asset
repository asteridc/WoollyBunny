  - text: "\u0422\u0430\u043A\u0436\u0435 \u043F\u043E\u043C\u043D\u0438\u0442\u0435,
      \u0444\u0443\u043D\u043A\u0446\u0438\u044F \u041E\u0441\u043E\u0431\u044B\u0445
      \u0438\u0441\u0442\u043E\u0440\u0438\u0439 \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u0430\u044F
      \u0438 \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u0439
      \u0441\u0432\u044F\u0437\u0438 \u0438\u0433\u0440\u043E\u043A\u043E\u0432.
      \u0412 \u043A\u043E\u043D\u0446\u0435 \u0441\u044E\u0436\u0435\u0442\u0430
      \u043E\u0446\u0435\u043D\u0438\u0442\u0435 \u0435\u0451 \u0438 \u0441\u0430\u043C\u0443
      \u0438\u0441\u0442\u043E\u0440\u0438\u044E."
