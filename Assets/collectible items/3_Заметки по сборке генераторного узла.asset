  m_Script: {fileID: 11500000, guid: 8ed67d7fa1678bd46878780468ced425, type: 3}
  m_Name: "3_\u0417\u0430\u043C\u0435\u0442\u043A\u0438 \u043F\u043E \u0441\u0431\u043E\u0440\u043A\u0435
    \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440\u043D\u043E\u0433\u043E
    \u0443\u0437\u043B\u0430"
  m_EditorClassIdentifier: 
  id: 3
  category: 2
  type: 1
  icon: {fileID: 21300000, guid: a42c8ec0ff27c024fab127cffe55cef1, type: 3}
  titleRu: "\u0417\u0430\u043C\u0435\u0442\u043A\u0438 \u043F\u043E \u0441\u0431\u043E\u0440\u043A\u0435
    \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440\u043D\u043E\u0433\u043E
    \u0443\u0437\u043B\u0430"
  contentRu: "\u041F\u043E\u0434\u043C\u0430\u0441\u0442\u0435\u0440\u044C\u044F\u043C
    \u0434\u043B\u044F \u0440\u0430\u0431\u043E\u0442\u044B:\r\n\r\n\u0426\u0435\u043F\u044C
    \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F \u043E\u0434\u043D\u043E\u043B\u0438\u043D\u0435\u0439\u043D\u043E,
    \u0441 \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C
    \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435\u043C \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u043E\u0432.
    \u041D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E:\r\n\r\n1. \u0418\u0441\u0442\u043E\u0447\u043D\u0438\u043A
    \u043F\u0438\u0442\u0430\u043D\u0438\u044F (\u0430\u043A\u043A\u0443\u043C\u0443\u043B\u044F\u0442\u043E\u0440)
    - \u043E\u043D \u0438\u0434\u0451\u0442 \u043F\u0435\u0440\u0432\u044B\u043C
    \u0432 \u0446\u0435\u043F\u0438 \u0438 \u043F\u043E\u0434\u0430\u0451\u0442 \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u0435.
    \u041F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0441\u044F
    \u043E\u0442 \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u043A\u043B\u0435\u043C\u043C\u044B (+), \u0438\u043D\u0430\u0447\u0435 \u043F\u043E\u043B\u0435\u0442\u044F\u0442
    \u0434\u0438\u043E\u0434\u044B. \r\n\r\n2. \u041F\u0440\u043E\u0432\u043E\u0434
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u0434\u043B\u044F
    \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u043E\u0432.
    \u0415\u0433\u043E \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u0435\u043C
    \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u0435\u043D\u0435\u0431\u0440\u0435\u0447\u044C,
    \u043D\u043E \u043A\u043E\u043D\u0442\u0430\u043A\u0442 \u0434\u043E\u043B\u0436\u0435\u043D
    \u0431\u044B\u0442\u044C \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E
    \u043F\u043B\u043E\u0442\u043D\u044B\u043C \u0438 \u0447\u0438\u0441\u0442\u044B\u043C,
    \u0438\u043D\u0430\u0447\u0435 \u0431\u0443\u0434\u0443\u0442 \u043F\u0430\u0434\u0435\u043D\u0438\u044F
    \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u044F.\r\n\r\n3. \u0420\u0435\u0437\u0438\u0441\u0442\u043E\u0440
    \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u0435\u0442\u0441\u044F \u0441\u0440\u0430\u0437\u0443
    \u043F\u043E\u0441\u043B\u0435 \u043F\u0440\u043E\u0432\u043E\u0434\u0430. \u0415\u0433\u043E
    \u0437\u0430\u0434\u0430\u0447\u0430 - \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0438\u0442\u044C
    \u0442\u043E\u043A. \u041F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435
    \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0438 \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E
    \u043D\u0435\u0434\u043E\u043F\u0443\u0441\u0442\u0438\u043C\u043E, \u0438\u043D\u0430\u0447\u0435
    \u043F\u0435\u0440\u0435\u0433\u0440\u0435\u0435\u0442\u0441\u044F \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A
    \u0438\u043B\u0438 \u0441\u0433\u043E\u0440\u0438\u0442 \u043F\u0440\u0435\u0434\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C.\r\n\r\n4.
    \u0412\u044B\u043A\u043B\u044E\u0447\u0430\u0442\u0435\u043B\u044C \u0441\u0442\u0430\u0432\u0438\u0442\u0441\u044F
    \u0432 \u0441\u0430\u043C\u043E\u043C \u043A\u043E\u043D\u0446\u0435, \u043F\u0435\u0440\u0435\u0434
    \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435\u043C \u0441 \u043C\u0438\u043D\u0443\u0441\u043E\u0432\u043E\u0439
    \u043A\u043B\u0435\u043C\u043C\u043E\u0439 (\u2013). \u041E\u043D \u0434\u043E\u043B\u0436\u0435\u043D
    \u0440\u0430\u0437\u0440\u044B\u0432\u0430\u0442\u044C \u0432\u0441\u044E \u0446\u0435\u043F\u044C,
    \u0430 \u043D\u0435 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u0443\u044E \u0432\u0435\u0442\u043A\u0443.
    \u041F\u0440\u0438 \u043E\u0442\u043A\u043B\u044E\u0447\u0451\u043D\u043D\u043E\u043C
    \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0438 - \u043D\u0438 \u043E\u0434\u0438\u043D
    \u044D\u043B\u0435\u043C\u0435\u043D\u0442 \u043D\u0435 \u0434\u043E\u043B\u0436\u0435\u043D
    \u043E\u0441\u0442\u0430\u0432\u0430\u0442\u044C\u0441\u044F \u043F\u043E\u0434
    \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u0435\u043C.\r\n\r\n\u0412\u0430\u0436\u043D\u043E:\r\n\r\n\u2022
    \u0411\u0435\u0437 \u0440\u0435\u0437\u0438\u0441\u0442\u043E\u0440\u0430 \u0446\u0435\u043F\u044C
    \u043D\u0435 \u0441\u0434\u0430\u0432\u0430\u0442\u044C.\r\n\u2022 \u0412\u044B\u043A\u043B\u044E\u0447\u0430\u0442\u0435\u043B\u044C
    \u043D\u0435 \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u0442\u044C \u0434\u0435\u043A\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u043C
    - \u043E\u043D \u0440\u0430\u0437\u0440\u044B\u0432\u0430\u0435\u0442 \u0446\u0435\u043F\u044C
    \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E.\r\n\u2022 \u041F\u043E\u043B\u044F\u0440\u043D\u043E\u0441\u0442\u044C
    \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u0430.\r\n\u2022
    \u041F\u043E\u0441\u043B\u0435 \u0441\u0431\u043E\u0440\u043A\u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u044C
    \u0442\u0435\u0441\u0442\u0435\u0440\u043E\u043C: \u0442\u043E\u043A \u0434\u043E\u043B\u0436\u0435\u043D
    \u0438\u0434\u0442\u0438 \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0441\u043B\u0435
    \u0437\u0430\u043C\u044B\u043A\u0430\u043D\u0438\u044F.\r\n\r\n\u041F\u043E\u0434\u043F\u0438\u0441\u044C:
    \u041C\u0430\u0441\u0442\u0435\u0440 \u0413.\u0425.\r"
  titleEn: Generator unit assembly notes
  contentEn: "For apprentices:\r\n\r\nBuild the circuit as a single series line -
    components connected one after another. Reminder:\r\n\r\n1. Power source (battery):
    It goes first in the circuit and supplies voltage. Connect from the positive
    terminal (+) first, otherwise you\u2019ll blow the diodes.\r\n\r\n2. Wire: Used
    to connect components. The wire\u2019s resistance is negligible, but the contact
    must be as tight and clean as possible, or you\u2019ll get voltage drop.\r\n\r\n3.
    Resistor: Install it right after the wire. Its job is to limit current. Do not
    connect the load directly, otherwise the source will overheat or you\u2019ll
    blow a fuse.\r\n\r\n4. Switch: Install it at the very end, before connecting
    to the negative terminal (\u2013). It must break the entire circuit, not just
    one branch. When it\u2019s OFF, no part of the circuit should remain energized.\r\n\r\nImportant:\r\n\r\n\u2022
    Do not submit the circuit without the resistor.\r\n\u2022 The switch must not
    be for show. It must cut power to the entire circuit.\r\n\u2022 Polarity matters.\r\n\u2022
    After assembly, check it with a multimeter: current should flow only after the
    switch is closed.\r\n\r\n\u2014 Master G.H.\r"
