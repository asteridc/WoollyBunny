  m_Name: "4_\u0421\u043F\u0438\u0441\u043E\u043A \u0442\u043E\u0432\u0430\u0440\u043E\u0432
    \u0434\u043B\u044F \u044D\u0432\u0430\u043A\u0443\u0430\u0446\u0438\u0438"
  m_EditorClassIdentifier: 
  id: 4
  category: 2
  collectionPrefab: {fileID: 0}
  type: 0
  icon: {fileID: 21300000, guid: bffc3e44adaab154cb933340ce53fdc7, type: 3}
  titleRu: "\u0421\u043F\u0438\u0441\u043E\u043A \u0442\u043E\u0432\u0430\u0440\u043E\u0432
    \u0434\u043B\u044F \u044D\u0432\u0430\u043A\u0443\u0430\u0446\u0438\u0438"
  contentRu: "(\u043B\u0438\u0441\u0442 \u0438\u0441\u043F\u0430\u0447\u043A\u0430\u043D,
    \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0441\u043B\u043E\u0432\u0430
    \u043F\u043B\u043E\u0445\u043E \u0447\u0438\u0442\u0430\u0435\u043C\u044B)\r\n\r\n\u0421\u043F\u0438\u0441\u043E\u043A
    \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u044B\u0445 \u0432\u0435\u0449\u0435\u0439\r\n1.
    \u0412\u043E\u0434\u0430 \u2013 2 \u043A\u0430\u043D\u0438\u0441\u0442\u0440\u044B\r\n2.
    \u041A\u043E\u043D\u0441\u0435\u0440\u0432\u044B \u2013 \u043F\u043E\u0431\u043E\u043B\u044C\u0448\u0435\r\n3.
    \u0410\u043F\u0442\u0435\u0447\u043A\u0430 \u2013 \u0431\u0438\u043D\u0442\u044B,
    \u0441\u043F\u0438\u0440\u0442, \u0430\u043D\u0442\u0438\u0431\u0438\u043E\u0442\u0438\u043A\u0438,
    \u0447\u0442\u043E \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C\r\n4. \u041E\u0440\u0443\u0436\u0438\u0435
    \u2013 \u043F\u0430\u0442\u0440\u043E\u043D\u044B \u043D\u0430 \u0438\u0441\u0445\u043E\u0434\u0435,
    \u043D\u0430\u0434\u043E \u043F\u043E\u0438\u0441\u043A\u0430\u0442\u044C \u0435\u0449\u0435\r\n5.
    \u0422\u0451\u043F\u043B\u0430\u044F \u043E\u0434\u0435\u0436\u0434\u0430 \u2013
    \u0431\u0440\u0430\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0430\u043C\u043E\u0435
    \u043D\u0443\u0436\u043D\u043E\u0435, \u0440\u044E\u043A\u0437\u0430\u043A \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439\r\n6.
    \u041B\u0430\u043C\u043F\u0430 \u043D\u0430 \u0431\u0430\u0442\u0430\u0440\u0435\u0439\u043A\u0430\u0445
    \u2013 \u0441\u0432\u0435\u0442\u0438\u0442\u044C \u043F\u043E\u043C\u0435\u043D\u044C\u0448\u0435,
    \u043E\u043D \u0438\u0445 \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u0435\u0442\r\n\r\n\u2014
    \u0411\u0435\u043D\u0437\u0438\u043D \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0441\u044F.
    \u041F\u0435\u0448\u043A\u043E\u043C.\r\n\u2014 \u041D\u0435 \u0437\u0430\u0431\u0443\u0434\u044C
    \u043C\u0430\u043C\u0438\u043D\u043E \u0444\u043E\u0442\u043E."
  titleEn: Evacuation supply list
  contentEn: "\u201C(The page is stained; some words are hard to read.)\r\n\r\nESSENTIAL
    SUPPLIES\r\n\r\nWater \u2014 2 jugs\r\nCanned food \u2014 as much as possible\r\nFirst-aid
    kit \u2014 bandages, alcohol, antibiotics, whatever\u2019s left\r\nWeapons \u2014
    low on ammo, need to find more\r\nWarm clothes \u2014 only the essentials, backpack\u2019s
    small\r\nBattery lamp \u2014 use it less, it draws them in\r\n\u2014 Out of gas.
    On foot.\r\n\u2014 Don\u2019t forget Mom\u2019s photo.\u201D\r"
