  m_Name: Story hints
  m_EditorClassIdentifier: 
  headingRu: "\u0412\u044B\u043A\u043B: \u0441\u044E\u0436\u0435\u0442\u043D\u044B\u0435
    \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438 \u0441\u043A\u0440\u044B\u0442\u044B\n\n\u0412\u043A\u043B:
    \u043E\u043A\u043E\u043B\u043E \u043A\u043D\u043E\u043F\u043E\u043A \u0432\u044B\u0431\u043E\u0440\u0430
    \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u044B \u0438\u043A\u043E\u043D\u043A\u0438
    \u041F\u0443\u0442\u0435\u0439 \u0433\u0435\u0440\u043E\u044F, \u0430 \u0442\u0430\u043A\u0436\u0435
    \u0438\u043A\u043E\u043D\u043A\u0430 \u0437\u043D\u0430\u0447\u0438\u043C\u043E\u0433\u043E
    \u0432\u044B\u0431\u043E\u0440\u0430, \u0432\u0435\u0434\u0443\u0449\u0435\u0433\u043E
    \u043A \u0441\u044E\u0436\u0435\u0442\u043D\u043E\u043C\u0443 \u0440\u0430\u0437\u0432\u0435\u0442\u0432\u043B\u0435\u043D\u0438\u044E"
  textRu: "\u0421\u044E\u0436\u0435\u0442\u043D\u044B\u0435 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438"
  headingEn: 'OFF: Choice hints are hidden.


    ON: Path icons are shown next to
    choice buttons, along with an icon marking a major choice that leads to a story
    branch.'
  textEn: Choice Hints
