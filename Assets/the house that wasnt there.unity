  m_Script: {fileID: 11500000, guid: ab4e3cca31ec2f845b660c0e40ccea61, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LocalizedText
  russianText: "\"\u0420\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u043E\u043D\u0435\u0440\"
    \u2014 Browning M1900 \u2014 \u043B\u0438\u0447\u043D\u044B\u0439 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442
    \u0412.\u0418. \u041B\u0435\u043D\u0438\u043D\u0430, \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0439
    \u0441 \u0441\u043E\u0431\u044B\u0442\u0438\u044F\u043C\u0438 \u041E\u043A\u0442\u044F\u0431\u0440\u044C\u0441\u043A\u043E\u0439
    \u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u0438."
  englishText: "The \"Revolutionary\" \u2014 a Browning M1900 \u2014 the personal
    pistol of V.I. Lenin, forever linked to the events of the October Revolution."
