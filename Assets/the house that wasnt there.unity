    - target: {fileID: 1388780311737873917, guid: cfeb5eabac51df642accec56bd63ffbe, type: 3}
      propertyPath: m_text
      value: "\u041A\u0430\u0436\u0434\u044B\u0439 \u0443\u0441\u043F\u0435\u0448\u043D\u044B\u0439
        \u0443\u0434\u0430\u0440 \u043F\u043E\u0432\u044B\u0448\u0430\u0435\u0442
        \u041A\u043E\u043C\u0431\u043E, \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u044E\u0449\u0435\u0435
        \u0443\u0440\u043E\u043D \u043E\u0442 \u0430\u0442\u0430\u043A\u0438. \u041F\u0440\u043E\u043C\u0430\u0445
        \u0438\u043B\u0438 \u0441\u043C\u0435\u043D\u0430 \u043E\u0440\u0443\u0436\u0438\u044F
        \u0441\u0431\u0438\u0432\u0430\u0435\u0442 \u044D\u0444\u0444\u0435\u043A\u0442."
      objectReference: {fileID: 0}
