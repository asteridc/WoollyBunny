    - target: {fileID: 1255120884401598652, guid: dc84b53fcf6897e4e9325e5f5dc41cd9, type: 3}
      propertyPath: englishText
      value: Shots mark the enemy. The third consecutive hit applies "Accusation",
        instantly killing the enemy if it hits the head.
      objectReference: {fileID: 0}
    - target: {fileID: 1255120884401598652, guid: dc84b53fcf6897e4e9325e5f5dc41cd9, type: 3}
      propertyPath: russianText
      value: "\u0412\u044B\u0441\u0442\u0440\u0435\u043B\u044B \u043F\u043E\u043C\u0435\u0447\u0430\u044E\u0442
        \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430. \u0422\u0440\u0435\u0442\u044C\u0435
        \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435 \u043F\u043E\u0434\u0440\u044F\u0434
        \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \xAB\u041E\u0431\u0432\u0438\u043D\u0435\u043D\u0438\u0435\xBB,
        \u0434\u043E\u0431\u0438\u0432\u0430\u044F \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430
        \u043F\u0440\u0438 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0438
        \u0432 \u0433\u043E\u043B\u043E\u0432\u0443."
      objectReference: {fileID: 0}
